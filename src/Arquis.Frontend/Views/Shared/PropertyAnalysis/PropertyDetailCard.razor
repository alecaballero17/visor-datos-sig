@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject IUserFriendlyErrorService ErrorService

<div class="property-analysis-card shadow-xl anim-scale-in @(isMinimized ? "is-minimized" : "")"
     role="region"
     aria-label="Ficha de información y diagnóstico del predio">
    <!-- Tirador táctil para móvil -->
    <div class="card-mobile-drag-handle d-lg-none" @onclick="ToggleMinimize" title="Alternar tamaño de la ficha" aria-hidden="true"></div>

    <!-- Barra superior de la tarjeta -->
    <div class="card-top-bar d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <span class="property-type-icon @GetBadgeTypeClass()" aria-hidden="true">
                <i class="bi @GetTypeIcon()"></i>
            </span>
            <div>
                <h5 class="property-title mb-0">@GetDisplayTitle()</h5>
                <span class="property-subtitle">@GetDisplaySubtitle()</span>
            </div>
        </div>
        <div class="card-window-actions d-flex align-items-center gap-1">
            <button type="button"
                    class="btn-win-action"
                    @onclick="ToggleMinimize"
                    title="@(isMinimized ? "Expandir ficha" : "Minimizar ficha")"
                    aria-label="@(isMinimized ? "Expandir ficha de predio" : "Minimizar ficha de predio")">
                <i class="bi @(isMinimized ? "bi-arrows-angle-expand" : "bi-dash-lg")" aria-hidden="true"></i>
            </button>
            <button type="button"
                    class="btn-win-action btn-win-close"
                    @onclick="CloseCard"
                    title="Cerrar ficha"
                    aria-label="Cerrar ficha de información">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    @if (!isMinimized)
    {
        <div class="card-main-content">
            <!-- Pestañas de análisis accesibles -->
            <ul class="nav nav-pills nav-fill analysis-tabs mb-3" role="tablist" aria-label="Secciones de análisis predial">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "resumen" ? "active" : "")"
                            role="tab"
                            id="tab-resumen"
                            aria-selected="@(activeTab == "resumen")"
                            aria-controls="panel-resumen"
                            @onclick='() => activeTab = "resumen"'>
                        <i class="bi bi-shield-check me-1" aria-hidden="true"></i>Diagnóstico
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "servicios" ? "active" : "")"
                            role="tab"
                            id="tab-servicios"
                            aria-selected="@(activeTab == "servicios")"
                            aria-controls="panel-servicios"
                            @onclick='() => activeTab = "servicios"'>
                        <i class="bi bi-droplet-half me-1" aria-hidden="true"></i>Agua Potable
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeTab == "catastro" ? "active" : "")"
                            role="tab"
                            id="tab-catastro"
                            aria-selected="@(activeTab == "catastro")"
                            aria-controls="panel-catastro"
                            @onclick='() => activeTab = "catastro"'>
                        <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>Ficha Predial
                    </button>
                </li>
            </ul>

            @if (isLoadingFicha)
            {
                <div class="py-4 text-center text-muted">
                    <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                    <div class="small fw-semibold">Consultando registro de servicios catastrales...</div>
                </div>
            }
            else
            {
                @if (activeTab == "resumen")
                {
                    <!-- TAB 1: DIAGNÓSTICO URBANO Y RESUMEN VISUAL -->
                    <div class="tab-resumen-content anim-fade-in">
                        <!-- Banner Semáforo Principal de Agua Potable -->
                        @if (HasWaterService)
                        {
                            <div class="status-banner banner-active-service shadow-sm mb-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="status-avatar bg-success text-white">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <h6 class="fw-bold text-success mb-1">Servicio de Agua Potable ACTIVO</h6>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                Con Conexión
                                            </span>
                                        </div>
                                        <p class="small text-secondary mb-2">
                                            Este predio cuenta con acometida y código fijo registrado en la red pública de distribución.
                                        </p>
                                        @if (!string.IsNullOrWhiteSpace(TitularName))
                                        {
                                            <div class="registered-holder-box p-2 rounded bg-light border">
                                                <small class="text-muted d-block text-uppercase" style="font-size:0.68rem; letter-spacing:0.05em;">Abonado / Titular Registrado:</small>
                                                <div class="fw-bold text-dark fs-6 text-truncate">
                                                    <i class="bi bi-person-badge me-1 text-primary"></i>@TitularName
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="status-banner banner-inactive-service shadow-sm mb-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="status-avatar bg-warning text-dark">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <h6 class="fw-bold text-warning-emphasis mb-1">Sin Conexión de Agua Registrada</h6>
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                Sin Suministro
                                            </span>
                                        </div>
                                        <p class="small text-secondary mb-2">
                                            El lote no presenta código fijo vinculado en catastro. Se encuentra en condición de predio sin suministro registrado.
                                        </p>
                                        <div class="recommendation-badge p-2 rounded bg-light border border-warning-subtle">
                                            <small class="text-warning-emphasis d-block fw-semibold">
                                                <i class="bi bi-info-circle me-1"></i>Acción sugerida:
                                            </small>
                                            <span class="small text-secondary">
                                                Verificar si existe tendido matriz sobre la vía para tramitar nueva acometida domiciliaria.
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Cuadrícula de Métricas Clave (KPIs) -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="metric-card p-2 rounded border bg-surface h-100">
                                    <span class="metric-label d-block text-muted">Clasificación</span>
                                    <span class="metric-val fw-bold text-primary">
                                        <i class="bi bi-building me-1"></i>Predio Urbano
                                    </span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="metric-card p-2 rounded border bg-surface h-100">
                                    <span class="metric-label d-block text-muted">Factibilidad Red</span>
                                    <span class="metric-val fw-bold text-dark">
                                        <i class="bi bi-water me-1 text-info"></i>En Red Matriz
                                    </span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="metric-card p-2 rounded border bg-surface h-100">
                                    <span class="metric-label d-block text-muted">Zona Catastral</span>
                                    <span class="metric-val fw-bold text-dark">
                                        UV @(GetProp("UV") ?? GetProp("Uv") ?? "Central")
                                    </span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="metric-card p-2 rounded border bg-surface h-100">
                                    <span class="metric-label d-block text-muted">Sector / Manzana</span>
                                    <span class="metric-val fw-bold text-dark">
                                        MZA @(GetProp("MZA") ?? GetProp("Manzana") ?? "-")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Barra de Herramientas y Acciones Rápidas -->
                        <div class="d-flex flex-wrap gap-2 pt-1 border-top">
                            <button type="button" class="btn btn-sm btn-primary flex-grow-1" @onclick="CenterOnMap">
                                <i class="bi bi-crosshair me-1"></i>Centrar Predio
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="RequestFormalReport" title="Generar informe técnico estructurado para imprimir o exponer">
                                <i class="bi bi-file-earmark-bar-graph-fill me-1"></i>Informe Formal
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyReport" title="Copiar resumen para informe">
                                <i class="bi @(isCopied ? "bi-check2" : "bi-clipboard") me-1"></i>
                                @(isCopied ? "¡Copiado!" : "Copiar")
                            </button>
                        </div>
                    </div>
                }
                else if (activeTab == "servicios")
                {
                    <!-- TAB 2: DETALLES HUMANIZADOS DEL AGUA POTABLE -->
                    <div class="tab-servicios-content anim-fade-in">
                        @if (fichaAgua?.Registros != null && fichaAgua.Registros.Count > 0)
                        {
                            <div class="mb-3">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-2">
                                    <i class="bi bi-water me-1"></i>@fichaAgua.Registros.Count conexión(es) detectada(s)
                                </span>
                            </div>

                            @foreach (var reg in fichaAgua.Registros)
                            {
                                <div class="service-account-card p-3 rounded border mb-2 bg-light">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="text-muted small text-uppercase fw-semibold" style="font-size:0.7rem">Código de Suministro:</span>
                                            <div class="h6 fw-bold text-primary mb-0">
                                                #@(reg.CodigoFijo ?? reg.IdCodigo)
                                            </div>
                                        </div>
                                        <span class="@reg.EstadoServicioBadgeClass">
                                            @reg.EstadoServicioTexto
                                        </span>
                                    </div>

                                    <table class="table table-sm table-borderless small mb-2">
                                        <tbody>
                                            <tr>
                                                <th class="text-secondary ps-0" style="width:40%">Titular de Cuenta:</th>
                                                <td class="fw-semibold text-dark">@(reg.NombreRegistrado ?? "No especificado")</td>
                                            </tr>
                                            <tr>
                                                <th class="text-secondary ps-0">Clave Catastral SIG:</th>
                                                <td class="font-monospace text-dark">@(reg.CodigoSig ?? "—")</td>
                                            </tr>
                                            <tr>
                                                <th class="text-secondary ps-0">Ubicación Toma:</th>
                                                <td>Lote @(reg.NumeroLote ?? "Principal"), Manzana @(reg.Manzana ?? "—")</td>
                                            </tr>
                                            @if (reg.Latitud.HasValue && reg.Longitud.HasValue)
                                            {
                                                <tr>
                                                    <th class="text-secondary ps-0">Coordenadas:</th>
                                                    <td class="font-monospace small">@reg.Latitud.Value.ToString("F5"), @reg.Longitud.Value.ToString("F5")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                    @if (LayerKey == "lotes")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary w-100" @onclick="() => HighlightWaterPoint(reg.IdCodigo)">
                                            <i class="bi bi-geo-alt-fill me-1 text-warning"></i>Alumbrar acometida en el mapa
                                        </button>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-secondary">
                                <i class="bi bi-droplet-slash fs-1 text-muted d-block mb-2"></i>
                                <h6>Sin registros de agua potable</h6>
                                <p class="small text-muted mb-0">
                                    No se encontraron códigos fijos vinculados a la geometría de este predio.
                                </p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- TAB 3: FICHA PREDIAL Y CATASTRO SIN JERGA -->
                    <div class="tab-catastro-content anim-fade-in">
                        <div class="p-2 bg-light rounded border mb-3">
                            <h6 class="small text-uppercase text-muted fw-bold mb-2">Identificación Cartográfica</h6>
                            <table class="table table-sm prop-table mb-0">
                                <tbody>
                                    <tr>
                                        <th>Capa Cartográfica</th>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@GetLayerDisplayName()</span></td>
                                    </tr>
                                    <tr>
                                        <th>Identificador Único</th>
                                        <td class="font-monospace">Ref-@FeatureId</td>
                                    </tr>
                                    @foreach (var kvp in FriendlyProperties)
                                    {
                                        <tr>
                                            <th>@kvp.Key</th>
                                            <td class="fw-semibold">@kvp.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (CoordinatesAvailable)
                        {
                            <div class="p-2 bg-white rounded border">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small text-muted fw-semibold">Georreferenciación GPS:</span>
                                    <button class="btn btn-sm btn-link text-decoration-none p-0" @onclick="CopyCoords">
                                        <i class="bi bi-copy me-1"></i>Copiar
                                    </button>
                                </div>
                                <code class="small d-block text-secondary mt-1">@CoordinatesString</code>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public string LayerKey { get; set; } = "lotes";
    [Parameter] public int FeatureId { get; set; }
    [Parameter] public Dictionary<string, object?> Properties { get; set; } = new();
    [Parameter] public double[]? Bbox { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCenterRequest { get; set; }
    [Parameter] public EventCallback<int> OnLocateWaterCode { get; set; }
    [Parameter] public EventCallback<int> OnRequestFormalReport { get; set; }

    private bool isMinimized = false;
    private bool isLoadingFicha = false;
    private bool isCopied = false;
    private string activeTab = "resumen";
    private FichaAguaResponse? fichaAgua;

    private bool HasWaterService =>
        (fichaAgua != null && fichaAgua.TieneAgua) ||
        (Properties.TryGetValue("TieneAgua", out var val) && val?.ToString()?.ToLower() == "true");

    private string? TitularName =>
        fichaAgua?.Registros?.FirstOrDefault()?.NombreRegistrado ??
        GetProp("Nombre");

    private bool CoordinatesAvailable =>
        (Properties.ContainsKey("AguaLatitud") && Properties.ContainsKey("AguaLongitud")) ||
        (Properties.ContainsKey("Latitud") && Properties.ContainsKey("Longitud"));

    private string CoordinatesString
    {
        get
        {
            var lat = GetProp("AguaLatitud") ?? GetProp("Latitud");
            var lon = GetProp("AguaLongitud") ?? GetProp("Longitud");
            if (lat != null && lon != null) return $"Lat: {lat}, Long: {lon}";
            return "Localizado en el mapa";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadWaterDetails();
    }

    private async Task LoadWaterDetails()
    {
        if (FeatureId <= 0) return;
        if (LayerKey != "lotes" && LayerKey != "codigosfijos")
        {
            fichaAgua = null;
            return;
        }

        isLoadingFicha = true;
        try
        {
            var endpoint = LayerKey == "lotes"
                ? $"api/agua-potable/lotes/{FeatureId}"
                : $"api/agua-potable/codigos/{FeatureId}";

            fichaAgua = await Http.GetFromJsonAsync<FichaAguaResponse>(endpoint);
        }
        catch (Exception ex)
        {
            fichaAgua = null;
            ErrorService.FromException(ex, "ficha técnica del predio", () => LoadWaterDetails());
        }
        finally
        {
            isLoadingFicha = false;
            StateHasChanged();
        }
    }

    private string? GetProp(string key)
    {
        if (Properties == null) return null;
        foreach (var kvp in Properties)
        {
            if (string.Equals(kvp.Key, key, StringComparison.OrdinalIgnoreCase))
                return kvp.Value?.ToString();
        }
        return null;
    }

    private string GetDisplayTitle()
    {
        if (LayerKey == "lotes")
        {
            var nro = GetProp("NroLote") ?? FeatureId.ToString();
            return $"Lote Residencial N° {nro}";
        }
        if (LayerKey == "codigosfijos")
        {
            var cod = GetProp("CodFijo") ?? FeatureId.ToString();
            return $"Toma de Agua #{cod}";
        }
        if (LayerKey == "manzanas")
        {
            var mza = GetProp("MZA") ?? FeatureId.ToString();
            var uv = GetProp("UV") ?? "-";
            return $"Manzana {mza} · UV {uv}";
        }
        if (LayerKey == "vias")
        {
            return GetProp("Nombre") ?? "Vía Pública";
        }
        return $"Entidad #{FeatureId}";
    }

    private string GetDisplaySubtitle()
    {
        var uv = GetProp("UV") ?? GetProp("Uv");
        var mza = GetProp("MZA") ?? GetProp("Manzana");
        if (uv != null || mza != null)
        {
            return $"Zona: UV {uv ?? "-"} · MZA {mza ?? "-"}";
        }
        if (LayerKey == "vias")
        {
            var tipo = GetProp("TipoVia");
            return $"Clasificación: {tipo ?? "Calle Urbana"}";
        }
        return "Registro Catastral Verificado";
    }

    private string GetTypeIcon() => LayerKey switch
    {
        "lotes" => "bi-house-door-fill",
        "codigosfijos" => "bi-droplet-fill",
        "manzanas" => "bi-grid-3x3-gap-fill",
        "vias" => "bi-signpost-split-fill",
        _ => "bi-geo-alt-fill"
    };

    private string GetBadgeTypeClass() => LayerKey switch
    {
        "lotes" => "badge-lote",
        "codigosfijos" => "badge-agua",
        "manzanas" => "badge-manzana",
        "vias" => "badge-via",
        _ => "badge-default"
    };

    private string GetLayerDisplayName() => LayerKey switch
    {
        "lotes" => "Lotes y Predios",
        "codigosfijos" => "Códigos Fijos / Agua Potable",
        "manzanas" => "Manzanas Urbanas",
        "vias" => "Red Vial",
        _ => LayerKey
    };

    private Dictionary<string, string> FriendlyProperties
    {
        get
        {
            var dict = new Dictionary<string, string>();
            if (Properties == null) return dict;

            foreach (var (k, v) in Properties)
            {
                if (v == null) continue;
                var strVal = v.ToString() ?? "";
                if (string.IsNullOrWhiteSpace(strVal)) continue;

                // Traducir campos técnicos a español legible para humanos
                switch (k.ToLowerInvariant())
                {
                    case "nrolote":
                        dict["Número de Lote"] = strVal;
                        break;
                    case "uv":
                        dict["Unidad Vecinal (UV)"] = strVal;
                        break;
                    case "mza":
                        dict["Manzana (MZA)"] = strVal;
                        break;
                    case "uv_mza":
                        dict["Sector Urbano"] = strVal;
                        break;
                    case "codfijo":
                        dict["Código de Conexión"] = strVal;
                        break;
                    case "codf_sig":
                        dict["Clave SIG Municipal"] = strVal;
                        break;
                    case "nombre":
                        dict["Titular / Denominación"] = strVal;
                        break;
                    case "tipovia":
                        dict["Tipo de Calzada"] = strVal;
                        break;
                    case "tieneagua":
                        dict["Disponibilidad de Agua"] = strVal.ToLower() == "true" ? "Sí, cuenta con servicio" : "No registra servicio";
                        break;
                    case "idmanzana":
                        dict["ID de Manzana"] = strVal;
                        break;
                    // Excluir id internos crudos o coordenadas ya mostradas
                    case "idlote":
                    case "idcodigo":
                    case "idvia":
                    case "agualatitud":
                    case "agualongitud":
                    case "latitud":
                    case "longitud":
                    case "idorigen":
                    case "objectid":
                    case "osmid":
                        break;
                    default:
                        dict[k] = strVal;
                        break;
                }
            }
            return dict;
        }
    }

    private void ToggleMinimize() => isMinimized = !isMinimized;
    private async Task CloseCard() => await OnClose.InvokeAsync();
    private async Task CenterOnMap() => await OnCenterRequest.InvokeAsync();
    private async Task RequestFormalReport() => await OnRequestFormalReport.InvokeAsync(FeatureId);

    private async Task HighlightWaterPoint(int codigoId)
    {
        await OnLocateWaterCode.InvokeAsync(codigoId);
    }

    private async Task CopyReport()
    {
        isCopied = true;
        var text = $"FICHA PREDIAL - {GetDisplayTitle()}\n" +
                   $"{GetDisplaySubtitle()}\n" +
                   $"Servicio de Agua: {(HasWaterService ? "Activo" : "Sin conexión")}\n" +
                   $"Titular: {TitularName ?? "No registrado"}\n" +
                   $"Coordenadas: {CoordinatesString}";

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        await Task.Delay(2000);
        isCopied = false;
        StateHasChanged();
    }

    private async Task CopyCoords()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", CoordinatesString);
    }
}
