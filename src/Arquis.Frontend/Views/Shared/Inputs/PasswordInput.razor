@inherits InputBaseComponent<string>

<div class="mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="form-label">@Label</label>
    }
    <input 
        type="password" 
        id="@Id" 
        class="@CssClass" 
        value="@Value" 
        @onchange="OnValueChanged" 
        required="@Required" />
</div>
