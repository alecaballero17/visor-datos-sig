@using System.Text
@inject HttpClient Http
@inject IJSRuntime JS
@inject IUserFriendlyErrorService ErrorService

@if (IsOpen)
{
    <div class="report-modal-backdrop anim-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="report-modal-title"
         tabindex="-1"
         @onkeydown="HandleKeyDown"
         @onclick="CloseModal">
        <div class="report-modal-card shadow-lg" style="border-radius: 10px; border: 1px solid #dadce0; width: min(1040px, 100%);" @onclick:stopPropagation="true">
            <!-- Barra superior del modal estilo Google Docs -->
            <div class="modal-card-header d-flex justify-content-between align-items-center px-4 py-2 border-bottom bg-white no-print flex-wrap gap-2" style="border-color:#dadce0 !important;">
                <div class="d-flex align-items-center gap-2">
                    <span class="d-inline-flex align-items-center justify-content-center rounded" style="width:32px; height:32px; background:#e8f0fe; color:#1a73e8;">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                    </span>
                    <div>
                        <div class="fw-bold mb-0" id="report-modal-title" style="color:#202124; font-size: 0.96rem;">Centro de Reportes e Informes Oficiales SIG</div>
                        <div class="small" style="color:#5f6368; font-size: 0.74rem;">Dictámenes prediales, análisis sectorial, cartera comercial, cuadrillas y rutas óptimas</div>
                    </div>
                </div>

                <div class="d-flex align-items-center flex-wrap gap-2">
                    <button type="button" class="btn btn-sm d-flex align-items-center gap-1" style="background:#1a73e8; color:#ffffff; border-radius:4px; font-weight:500;"
                            disabled="@isLoading"
                            @onclick="DownloadServerPdf"
                            title="Descargar documento PDF oficial">
                        <i class="bi bi-file-earmark-pdf"></i>
                        <span>PDF</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1" style="border-radius:4px; font-weight:500;"
                            disabled="@isLoading"
                            @onclick="DownloadCsv"
                            title="Exportar datos tabulados a Excel (CSV)">
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                        <span>Excel / CSV</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-color:#dadce0; color:#3c4043; border-radius:4px;" @onclick="PrintReport" title="Imprimir">
                        <i class="bi bi-printer me-1"></i>Imprimir
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-color:#dadce0; color:#3c4043; border-radius:4px;" @onclick="CopyReportText" title="Copiar resumen">
                        <i class="bi @(isCopied ? "bi-check2 text-success" : "bi-clipboard") me-1"></i>
                        @(isCopied ? "Copiado" : "Copiar")
                    </button>
                    <a href="/bitacora" class="btn btn-sm btn-outline-secondary text-decoration-none" style="border-color:#dadce0; color:#3c4043; border-radius:4px;" title="Ver bitácora de auditoría">
                        <i class="bi bi-journal-text me-1"></i>Bitácora
                    </a>
                    <button type="button" class="btn-close ms-1" @onclick="CloseModal" aria-label="Cerrar modal"></button>
                </div>
            </div>

            <!-- Selector de Tipo de Reporte y Filtros Dinámicos -->
            <div class="px-4 py-2 border-bottom bg-light no-print" style="border-color:#dadce0 !important;">
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var tab in ReporteTipos)
                    {
                        var active = tipoActivo == tab.Key;
                        <button type="button"
                                class="btn btn-sm @(active ? "btn-primary" : "btn-outline-secondary bg-white")"
                                style="border-radius: 999px; font-size: 0.76rem; font-weight: @(active ? "600" : "500");"
                                @onclick="() => CambiarTipoReporte(tab.Key)">
                            <i class="bi @tab.Icon me-1"></i>@tab.Label
                        </button>
                    }
                </div>

                <!-- Barra de Parámetros según el Tipo Seleccionado -->
                <div class="d-flex flex-wrap align-items-end gap-2 pt-1">
                    @if (tipoActivo == "predial")
                    {
                        <div style="width:160px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">ID Interno de Lote</label>
                            <input type="number" class="form-control form-control-sm" min="1" @bind="filtroLoteId" />
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GenerateReport">
                            <i class="bi bi-search me-1"></i>Consultar Predio
                        </button>
                    }
                    else if (tipoActivo == "sector")
                    {
                        <div style="width:170px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Unidad Vecinal (UV)</label>
                            <select class="form-select form-select-sm" @bind="filtroSectorUv" @bind:after="OnSectorUvChanged">
                                <option value="">-- Todas las UV --</option>
                                @foreach (var uv in listaUvs)
                                {
                                    <option value="@uv">UV @uv</option>
                                }
                            </select>
                        </div>
                        <div style="width:170px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Manzana (MZA)</label>
                            <select class="form-select form-select-sm" @bind="filtroSectorMza">
                                <option value="">-- Todas las MZA --</option>
                                @foreach (var m in ManzanasFiltradas)
                                {
                                    <option value="@m.MZA">MZA @m.MZA</option>
                                }
                            </select>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GenerateReport">
                            <i class="bi bi-funnel me-1"></i>Generar Diagnóstico
                        </button>
                    }
                    else if (tipoActivo == "operaciones")
                    {
                        <div style="width:140px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Tipo de Orden</label>
                            <select class="form-select form-select-sm" @bind="filtroOpTipo">
                                <option value="Todos">Todos</option>
                                <option value="Corte">Corte</option>
                                <option value="Reconexion">Reconexión / Rep.</option>
                            </select>
                        </div>
                        <div style="width:140px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Estado de Ruta</label>
                            <select class="form-select form-select-sm" @bind="filtroOpEstado">
                                <option value="Todos">Activos (Todos)</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="EnProgreso">En Progreso</option>
                                <option value="Completada">Completada</option>
                            </select>
                        </div>
                        <div style="width:170px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Operario Asignado</label>
                            <select class="form-select form-select-sm" @bind="filtroOpOperario">
                                <option value="Todos">Todos</option>
                                @foreach (var op in listaOperarios)
                                {
                                    <option value="@op.OperarioId">@op.NombreOperario (@op.Rol)</option>
                                }
                            </select>
                        </div>
                        <div style="width:135px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Desde</label>
                            <input type="date" class="form-control form-control-sm" @bind="filtroDesde" />
                        </div>
                        <div style="width:135px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Hasta</label>
                            <input type="date" class="form-control form-control-sm" @bind="filtroHasta" />
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GenerateReport">
                            <i class="bi bi-funnel me-1"></i>Aplicar
                        </button>
                    }
                    else if (tipoActivo == "cuadrillas")
                    {
                        <div style="width:180px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Rol de Cuadrilla</label>
                            <select class="form-select form-select-sm" @bind="filtroCuadrillaRol">
                                <option value="Todos">Todos los técnicos</option>
                                <option value="Cortador">Solo Cortadores</option>
                                <option value="Reconector">Solo Reponedores / Recon.</option>
                            </select>
                        </div>
                        <div style="width:140px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Desde</label>
                            <input type="date" class="form-control form-control-sm" @bind="filtroDesde" />
                        </div>
                        <div style="width:140px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Hasta</label>
                            <input type="date" class="form-control form-control-sm" @bind="filtroHasta" />
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GenerateReport">
                            <i class="bi bi-funnel me-1"></i>Evaluar Cuadrillas
                        </button>
                    }
                    else if (tipoActivo == "suministros")
                    {
                        <div style="width:190px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Estado de Suministro</label>
                            <select class="form-select form-select-sm" @bind="filtroSumEstado">
                                <option value="">-- Todos los estados --</option>
                                <option value="1">1 · Normal / Activo</option>
                                <option value="2">2 · Notificado para Corte</option>
                                <option value="3">3 · Cortado / Suspendido</option>
                                <option value="0">0 · Para Reconexión</option>
                                <option value="4">4 · Baja Parcial</option>
                                <option value="5">5 · Baja Total</option>
                            </select>
                        </div>
                        <div style="width:150px;">
                            <label class="form-label small text-muted mb-0" style="font-size:0.7rem;">Unidad Vecinal (UV)</label>
                            <select class="form-select form-select-sm" @bind="filtroSumUv">
                                <option value="">-- Todas las UV --</option>
                                @foreach (var uv in listaUvs)
                                {
                                    <option value="@uv">UV @uv</option>
                                }
                            </select>
                        </div>
                        <div class="form-check form-switch mb-1 ms-1">
                            <input class="form-check-input" type="checkbox" id="chkSoloVerif" @bind="filtroSumSoloVerificados" />
                            <label class="form-check-label small" for="chkSoloVerif">Solo verificados</label>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GenerateReport">
                            <i class="bi bi-funnel me-1"></i>Auditar Cartera
                        </button>
                    }
                    else
                    {
                        <span class="small text-muted me-2">Consolidado catastral, hidráulico y operativo del municipio en tiempo real.</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GenerateReport">
                            <i class="bi bi-arrow-clockwise me-1"></i>Actualizar Datos
                        </button>
                    }
                </div>
            </div>

            <!-- Contenido del modal -->
            <div class="modal-card-body p-3 p-md-4 overflow-auto" style="background:#f1f3f4; flex: 1 1 auto; min-height: 0;">
                @if (isLoading)
                {
                    <div class="py-5 text-center text-muted">
                        <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                        <div class="small fw-semibold" style="color:#5f6368">Procesando datos catastrales y generando informe...</div>
                    </div>
                }
                else
                {
                    <!-- HOJA FORMAL DEL REPORTE ESTILO GOOGLE DOCS -->
                    <div class="formal-report-sheet p-4 bg-white rounded border" style="border-color:#dadce0 !important; max-width:900px; margin:0 auto; color:#202124;">
                        <!-- Membrete Institucional -->
                        <div class="pb-3 mb-3 border-bottom d-flex justify-content-between align-items-start gap-2" style="border-color:#dadce0 !important;">
                            <div>
                                <span class="small text-uppercase fw-semibold d-block mb-1" style="color:#5f6368; font-size:0.75rem; letter-spacing:0.3px;">
                                    DIRECCIÓN DE CATASTRO Y PLANIFICACIÓN URBANA · ARQUIS SIG
                                </span>
                                <h5 class="fw-bold mb-0 text-uppercase" style="color:#202124;">
                                    @TituloActual
                                </h5>
                                <span class="small" style="color:#1a73e8;">
                                    @SubtituloActual
                                </span>
                            </div>
                            <div class="text-end text-nowrap">
                                <span class="px-2 py-1 rounded border small font-monospace d-inline-block mb-1" style="background:#f8f9fa; border-color:#dadce0 !important; color:#3c4043; font-size:0.75rem;">
                                    @CodigoActual
                                </span>
                                <div class="small text-muted" style="font-size:0.72rem;">Emisión: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                                <div class="small text-muted" style="font-size:0.72rem;">Operador: @CurrentUserName</div>
                            </div>
                        </div>

                        @if (tipoActivo == "predial" && reportePredial != null)
                        {
                            <!-- REPORTE 1: PREDIO / LOTE -->
                            <div class="mb-4">
                                <div class="fw-bold mb-2 pb-1 border-bottom small text-uppercase" style="color:#5f6368; font-size:0.75rem;">1. Identificación y Localización del Inmueble</div>
                                <div class="row g-2 mb-2">
                                    <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.7rem">N° DE LOTE</span><span class="fw-bold fs-6">Lote @reportePredial.NumeroLote</span></div></div>
                                    <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.7rem">MANZANA</span><span class="fw-bold fs-6">MZA @reportePredial.Manzana</span></div></div>
                                    <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.7rem">UNIDAD VECINAL</span><span class="fw-bold fs-6">UV @reportePredial.UnidadVecinal</span></div></div>
                                    <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.7rem">CLASIFICACIÓN</span><span class="fw-bold fs-6 text-primary">@reportePredial.ClasificacionUrbana</span></div></div>
                                </div>
                                <div class="p-2 border rounded small d-flex justify-content-between bg-light">
                                    <span><strong>Coordenadas GPS:</strong> @reportePredial.CoordenadasDisplay</span>
                                    <span><strong>Sector:</strong> @reportePredial.Sector</span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="fw-bold mb-2 pb-1 border-bottom small text-uppercase" style="color:#5f6368; font-size:0.75rem;">2. Suministro de Agua Potable</div>
                                <div class="p-3 rounded border bg-light mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-bold" style="font-size:0.9rem;">@reportePredial.EstadoTexto</div>
                                        <span class="badge @(reportePredial.TieneAgua ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@reportePredial.CondicionOperativa</span>
                                    </div>
                                    <div class="row g-2 small">
                                        <div class="col-sm-6"><span class="text-secondary">Titular:</span> <strong>@(reportePredial.Titular ?? "No asignado")</strong></div>
                                        <div class="col-sm-6"><span class="text-secondary">Código Suministro:</span> <strong>#@(reportePredial.CodigoSuministro ?? "—")</strong></div>
                                        <div class="col-sm-6"><span class="text-secondary">Clave SIG:</span> <strong>@reportePredial.CodigoSig</strong></div>
                                        <div class="col-sm-6"><span class="text-secondary">Cobertura Manzana:</span> <strong>@reportePredial.PorcentajeCoberturaManzana% (@reportePredial.LotesConAguaManzana/@reportePredial.TotalLotesManzana)</strong></div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-2">
                                <div class="fw-bold mb-2 pb-1 border-bottom small text-uppercase" style="color:#5f6368; font-size:0.75rem;">3. Dictamen Técnico y Recomendaciones</div>
                                <div class="p-3 border rounded small bg-light mb-2">@reportePredial.ResumenEjecutivo</div>
                                <ul class="small ps-3 mb-0 text-secondary">
                                    @foreach (var rec in reportePredial.Recomendaciones) { <li class="mb-1">@rec</li> }
                                </ul>
                            </div>
                        }
                        else if (tipoActivo == "sector" && reporteSector != null)
                        {
                            <!-- REPORTE 2: SECTOR / MANZANA -->
                            <div class="row g-2 mb-3">
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded text-center bg-light"><span class="small text-muted d-block" style="font-size:0.7rem;">UNIDAD VECINAL</span><span class="fw-bold fs-6">UV @(string.IsNullOrWhiteSpace(reporteSector.UnidadVecinal) ? "Todas" : reporteSector.UnidadVecinal)</span></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded text-center bg-light"><span class="small text-muted d-block" style="font-size:0.7rem;">TOTAL PREDIOS</span><span class="fw-bold fs-6">@reporteSector.TotalPredios</span></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded text-center bg-light"><span class="small text-muted d-block" style="font-size:0.7rem;">COBERTURA</span><span class="fw-bold fs-6 text-primary">@reporteSector.PorcentajeCobertura%</span></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded text-center bg-light"><span class="small text-muted d-block" style="font-size:0.7rem;">CONSOLIDACIÓN</span><span class="fw-bold fs-6 text-success">@reporteSector.IndiceConsolidacion</span></div></div>
                            </div>
                            <div class="p-3 border rounded small bg-light mb-3">@reporteSector.DiagnosticoSituacional</div>

                            <div class="table-responsive border rounded mb-3" style="max-height: 260px; overflow-y: auto;">
                                <table class="table table-sm table-hover mb-0" style="font-size:0.8rem;">
                                    <thead class="sticky-top bg-light">
                                        <tr style="color:#5f6368; font-size:0.72rem; text-transform:uppercase;">
                                            <th class="ps-3">N° Lote</th><th>Estado Suministro</th><th>Titular</th><th>Código Cuenta</th><th class="pe-3">Condición</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var predio in reporteSector.Predios)
                                        {
                                            <tr>
                                                <td class="ps-3 fw-semibold">Lote @predio.NumeroLote</td>
                                                <td><span class="badge @(predio.TieneAgua ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@predio.EstadoServicio</span></td>
                                                <td>@(predio.Titular ?? "—")</td>
                                                <td class="font-monospace small">#@(predio.CodigoSuministro ?? "—")</td>
                                                <td class="pe-3 text-muted">@predio.Condicion</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <ul class="small ps-3 mb-0 text-secondary">
                                @foreach (var rec in reporteSector.RecomendacionesTecnicas) { <li class="mb-1">@rec</li> }
                            </ul>
                        }
                        else if (tipoActivo == "operaciones" && reporteOperaciones != null)
                        {
                            <!-- REPORTE 3: ÓRDENES Y RUTAS -->
                            <div class="row g-2 mb-3">
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">RUTAS / ÓRDENES</span><span class="fw-bold fs-5 text-primary">@reporteOperaciones.TotalRutas</span><div class="small text-muted">@reporteOperaciones.RutasCompletadas cerradas</div></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">AVANCE DE PARADAS</span><span class="fw-bold fs-5 text-success">@reporteOperaciones.PorcentajeAvance%</span><div class="small text-muted">@reporteOperaciones.ParadasCompletadas / @reporteOperaciones.TotalParadas predios</div></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">DISTANCIA DIJKSTRA</span><span class="fw-bold fs-5 text-info">@reporteOperaciones.DistanciaTotalKm.ToString("F2") km</span><div class="small text-muted">@reporteOperaciones.ParadasObservadas observadas</div></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">CARTERA EN MORA</span><span class="fw-bold fs-5 text-danger">Bs. @reporteOperaciones.MontoTotalDeudaBs.ToString("N2")</span><div class="small text-muted">Antifraude OK: @reporteOperaciones.ValidacionesAntifraudeOk/@reporteOperaciones.ValidacionesGpsTotales</div></div></div>
                            </div>

                            <div class="p-3 border rounded small bg-light mb-3">@reporteOperaciones.ResumenEjecutivo</div>

                            <div class="fw-bold mb-2 small text-uppercase text-muted" style="font-size:0.75rem;">Listado de Hojas de Ruta (@reporteOperaciones.Rutas.Count)</div>
                            <div class="table-responsive border rounded mb-3" style="max-height: 260px; overflow-y: auto;">
                                <table class="table table-sm table-hover mb-0" style="font-size:0.78rem;">
                                    <thead class="sticky-top bg-light">
                                        <tr style="color:#5f6368; font-size:0.7rem; text-transform:uppercase;">
                                            <th class="ps-2">Código</th><th>Tipo</th><th>Operario</th><th>Estado</th><th>Dist. km</th><th>Paradas</th><th class="pe-2">Mora (Bs.)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in reporteOperaciones.Rutas)
                                        {
                                            <tr>
                                                <td class="ps-2 fw-bold font-monospace text-primary">@r.Codigo</td>
                                                <td><span class="badge @(r.Tipo == "Corte" ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary")">@r.Tipo</span></td>
                                                <td>@r.OperarioAsignado</td>
                                                <td><span class="badge bg-light text-dark border">@r.Estado</span></td>
                                                <td>@r.DistanciaKm.ToString("F2")</td>
                                                <td><strong>@r.PuntosCompletados/@r.TotalPuntos</strong> @(r.PuntosObservados > 0 ? $"({r.PuntosObservados} obs)" : "")</td>
                                                <td class="pe-2">@r.MontoDeudaTotalBs.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <ul class="small ps-3 mb-0 text-secondary">
                                @foreach (var rec in reporteOperaciones.Recomendaciones) { <li class="mb-1">@rec</li> }
                            </ul>
                        }
                        else if (tipoActivo == "cuadrillas" && reporteCuadrillas != null)
                        {
                            <!-- REPORTE 4: DESEMPEÑO DE CUADRILLAS -->
                            <div class="row g-2 mb-3">
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">TÉCNICOS ACTIVOS</span><span class="fw-bold fs-5">@reporteCuadrillas.TotalOperarios</span><div class="small text-muted">@reporteCuadrillas.TotalCortadores Cort · @reporteCuadrillas.TotalReconectores Rep</div></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">RUTAS ASIGNADAS</span><span class="fw-bold fs-5 text-primary">@reporteCuadrillas.TotalRutasAsignadas</span><div class="small text-muted">@reporteCuadrillas.DistanciaTotalKm.ToString("F2") km recorridos</div></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">INTERVENCIONES</span><span class="fw-bold fs-5 text-success">@reporteCuadrillas.TotalEjecutadas / @reporteCuadrillas.TotalParadasAsignadas</span><div class="small text-muted">@reporteCuadrillas.TotalObservadas observadas</div></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">CUMPLIMIENTO GLOBAL</span><span class="fw-bold fs-5 text-info">@reporteCuadrillas.CumplimientoPromedioPct%</span><div class="small text-muted">@reporteCuadrillas.TotalPendientes pendientes</div></div></div>
                            </div>

                            <div class="p-3 border rounded small bg-light mb-3">@reporteCuadrillas.ResumenEjecutivo</div>

                            <div class="table-responsive border rounded mb-3" style="max-height: 270px; overflow-y: auto;">
                                <table class="table table-sm table-hover mb-0" style="font-size:0.78rem;">
                                    <thead class="sticky-top bg-light">
                                        <tr style="color:#5f6368; font-size:0.7rem; text-transform:uppercase;">
                                            <th class="ps-2">Operario</th><th>Rol</th><th>Rutas</th><th>Ejecutadas</th><th>Obs / Pend</th><th>Cumpl.</th><th>GPS Prom.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in reporteCuadrillas.Cuadrillas)
                                        {
                                            <tr>
                                                <td class="ps-2 fw-semibold">@c.NombreOperario <span class="text-muted small">(@c.OperarioId)</span></td>
                                                <td><span class="badge @(c.Rol.Contains("Cortador") ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary")">@c.Rol</span></td>
                                                <td>@c.RutasCompletadas / @c.RutasAsignadas</td>
                                                <td class="fw-bold text-success">@c.Ejecutadas / @c.ParadasTotales</td>
                                                <td>@c.Observadas / @c.Pendientes</td>
                                                <td><span class="badge @(c.PorcentajeCumplimiento >= 80 ? "bg-success" : "bg-primary")">@c.PorcentajeCumplimiento%</span></td>
                                                <td>@(c.PrecisionGpsPromedioMetros.HasValue ? $"{c.PrecisionGpsPromedioMetros:F1} m" : "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <ul class="small ps-3 mb-0 text-secondary">
                                @foreach (var rec in reporteCuadrillas.Recomendaciones) { <li class="mb-1">@rec</li> }
                            </ul>
                        }
                        else if (tipoActivo == "suministros" && reporteSuministros != null)
                        {
                            <!-- REPORTE 5: AUDITORÍA DE SUMINISTROS -->
                            <div class="row g-2 mb-3">
                                <div class="col-6 col-md-2"><div class="p-2 border rounded bg-light text-center"><span class="small text-muted d-block" style="font-size:0.65rem;">TOTAL</span><strong class="fs-5">@reporteSuministros.TotalSuministros</strong></div></div>
                                <div class="col-6 col-md-2"><div class="p-2 border rounded bg-light text-center"><span class="small text-muted d-block" style="font-size:0.65rem;">NORMAL</span><strong class="fs-5 text-success">@reporteSuministros.Normal</strong></div></div>
                                <div class="col-6 col-md-2"><div class="p-2 border rounded bg-light text-center"><span class="small text-muted d-block" style="font-size:0.65rem;">PARA CORTE</span><strong class="fs-5 text-warning">@reporteSuministros.ParaCorte</strong></div></div>
                                <div class="col-6 col-md-2"><div class="p-2 border rounded bg-light text-center"><span class="small text-muted d-block" style="font-size:0.65rem;">CORTADOS</span><strong class="fs-5 text-danger">@reporteSuministros.Cortado</strong></div></div>
                                <div class="col-6 col-md-2"><div class="p-2 border rounded bg-light text-center"><span class="small text-muted d-block" style="font-size:0.65rem;">PARA REC.</span><strong class="fs-5 text-info">@reporteSuministros.ParaReconexion</strong></div></div>
                                <div class="col-6 col-md-2"><div class="p-2 border rounded bg-light text-center"><span class="small text-muted d-block" style="font-size:0.65rem;">VERIFICADOS</span><strong class="fs-5 text-primary">@reporteSuministros.Verificados</strong></div></div>
                            </div>

                            <div class="p-3 border rounded small bg-light mb-3">@reporteSuministros.ResumenEjecutivo</div>

                            <div class="table-responsive border rounded mb-3" style="max-height: 270px; overflow-y: auto;">
                                <table class="table table-sm table-hover mb-0" style="font-size:0.78rem;">
                                    <thead class="sticky-top bg-light">
                                        <tr style="color:#5f6368; font-size:0.7rem; text-transform:uppercase;">
                                            <th class="ps-2">Cód. Fijo</th><th>Clave SIG</th><th>Titular</th><th>Ubicación</th><th>Estado Actual</th><th>Verificado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in reporteSuministros.Suministros)
                                        {
                                            <tr>
                                                <td class="ps-2 fw-bold">#@s.CodigoFijo</td>
                                                <td class="font-monospace small text-muted">@s.CodigoSig</td>
                                                <td>@s.Titular</td>
                                                <td>UV @s.UnidadVecinal · MZA @s.Manzana · L @s.NumeroLote</td>
                                                <td><span class="badge @(s.EstadoCodigo == 1 ? "bg-success-subtle text-success" : (s.EstadoCodigo is 2 or 3 ? "bg-danger-subtle text-danger" : "bg-info-subtle text-dark"))">@s.EstadoTexto</span></td>
                                                <td>@(s.EstadoVerificado ? "Sí" : "Pendiente")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <ul class="small ps-3 mb-0 text-secondary">
                                @foreach (var rec in reporteSuministros.Recomendaciones) { <li class="mb-1">@rec</li> }
                            </ul>
                        }
                        else if (tipoActivo == "ejecutivo" && reporteEjecutivo != null)
                        {
                            <!-- REPORTE 6: EJECUTIVO GLOBAL -->
                            <div class="row g-2 mb-3">
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">PREDIOS CATASTRADOS</span><span class="fw-bold fs-5">@reporteEjecutivo.TotalLotes.ToString("N0")</span><div class="small text-muted">@reporteEjecutivo.TotalManzanas manzanas</div></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">COBERTURA HÍDRICA</span><span class="fw-bold fs-5 text-primary">@reporteEjecutivo.CoberturaGlobalPct%</span><div class="small text-muted">@reporteEjecutivo.LotesConServicio.ToString("N0") lotes con agua</div></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">RED VIAL TOTAL</span><span class="fw-bold fs-5 text-info">@reporteEjecutivo.LongitudRedVialKm.ToString("N1") km</span><div class="small text-muted">@reporteEjecutivo.TotalVias tramos</div></div></div>
                                <div class="col-sm-3 col-6"><div class="p-2 border rounded bg-light"><span class="small text-muted d-block" style="font-size:0.68rem;">EFECTIVIDAD CAMPO</span><span class="fw-bold fs-5 text-success">@reporteEjecutivo.TasaEfectividadCampoPct%</span><div class="small text-muted">@reporteEjecutivo.IntervencionesCompletadas / @reporteEjecutivo.TotalIntervencionesCampo paradas</div></div></div>
                            </div>

                            <div class="p-3 border rounded small bg-light mb-3">@reporteEjecutivo.ResumenEjecutivo</div>

                            <div class="fw-bold mb-2 small text-uppercase text-muted" style="font-size:0.75rem;">Resumen Territorial por Unidad Vecinal</div>
                            <div class="table-responsive border rounded mb-3" style="max-height: 260px; overflow-y: auto;">
                                <table class="table table-sm table-hover mb-0" style="font-size:0.78rem;">
                                    <thead class="sticky-top bg-light">
                                        <tr style="color:#5f6368; font-size:0.7rem; text-transform:uppercase;">
                                            <th class="ps-2">UV</th><th>Manzanas</th><th>Lotes</th><th>Con Agua</th><th>Cobertura</th><th>Para Corte</th><th>Cortados</th><th>Para Rec.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var uv in reporteEjecutivo.ResumenPorUv)
                                        {
                                            <tr>
                                                <td class="ps-2 fw-bold">UV @uv.UnidadVecinal</td>
                                                <td>@uv.TotalManzanas</td>
                                                <td>@uv.TotalLotes</td>
                                                <td class="text-success fw-semibold">@uv.LotesConAgua</td>
                                                <td><span class="badge bg-primary-subtle text-primary">@uv.CoberturaPct%</span></td>
                                                <td class="text-warning fw-semibold">@uv.CuentasParaCorte</td>
                                                <td class="text-danger fw-semibold">@uv.CuentasCortadas</td>
                                                <td class="text-info fw-semibold">@uv.CuentasParaReconexion</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <ul class="small ps-3 mb-0 text-secondary">
                                @foreach (var rec in reporteEjecutivo.Recomendaciones) { <li class="mb-1">@rec</li> }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-file-earmark-text fs-1 d-block mb-2"></i>
                                <div>Seleccione los filtros deseados y presione generar para emitir su reporte oficial.</div>
                            </div>
                        }

                        <!-- Pie del Reporte con firmas institucionales -->
                        <div class="pt-3 mt-4 border-top" style="border-color:#dadce0 !important;">
                            <div class="row text-center text-muted small">
                                <div class="col-6">
                                    <div class="signature-line mx-auto mb-1" style="width: 140px; border-bottom: 1px solid #dadce0; height: 30px;"></div>
                                    <span style="font-size:0.75rem; color:#5f6368;">Responsable de Catastro</span>
                                </div>
                                <div class="col-6">
                                    <div class="signature-line mx-auto mb-1" style="width: 140px; border-bottom: 1px solid #dadce0; height: 30px;"></div>
                                    <span style="font-size:0.75rem; color:#5f6368;">Dirección de Planificación</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-card-footer px-4 py-2 border-top d-flex justify-content-between align-items-center bg-white no-print" style="border-color:#dadce0 !important;">
                <a href="/bitacora" class="btn btn-sm btn-outline-secondary" style="border-color:#dadce0; color:#3c4043; border-radius:4px;">
                    Ver Bitácora de Auditoría
                </a>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="DownloadCsv" disabled="@isLoading">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i>Exportar CSV
                    </button>
                    <button type="button" class="btn btn-sm d-flex align-items-center gap-1" style="background:#1a73e8; color:#ffffff; border-radius:4px; font-weight:500;" @onclick="DownloadServerPdf" disabled="@isLoading">
                        <i class="bi bi-file-earmark-pdf"></i>
                        <span>Descargar PDF</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-color:#dadce0; color:#3c4043; border-radius:4px;" @onclick="CloseModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter] public int? SelectedLoteId { get; set; }
    [Parameter] public string? SelectedUV { get; set; }
    [Parameter] public string? SelectedMZA { get; set; }
    [Parameter] public string CurrentUserName { get; set; } = "Usuario SIG";

    private bool isLoading = false;
    private bool isCopied = false;
    private bool catalogosCargados = false;
    private bool wasOpen = false;

    private string tipoActivo = "ejecutivo";

    // Filtros dinámicos
    private int filtroLoteId = 1;
    private string filtroSectorUv = "";
    private string filtroSectorMza = "";
    private string filtroOpTipo = "Todos";
    private string filtroOpEstado = "Todos";
    private string filtroOpOperario = "Todos";
    private string filtroCuadrillaRol = "Todos";
    private string filtroSumEstado = "";
    private string filtroSumUv = "";
    private bool filtroSumSoloVerificados = false;
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;

    // Catálogos auxiliares
    private List<string> listaUvs = new();
    private List<ZonaManzanaDto> listaManzanas = new();
    private List<OperarioMiniDto> listaOperarios = new();
    private IEnumerable<ZonaManzanaDto> ManzanasFiltradas => string.IsNullOrWhiteSpace(filtroSectorUv)
        ? listaManzanas
        : listaManzanas.Where(m => m.UV == filtroSectorUv);

    // Modelos cargados
    private ReportePredialModel? reportePredial;
    private ReporteSectorModel? reporteSector;
    private ReporteOperacionesRutasModel? reporteOperaciones;
    private ReporteDesempenoCuadrillasModel? reporteCuadrillas;
    private ReporteEstadoSuministrosModel? reporteSuministros;
    private ReporteEjecutivoGlobalModel? reporteEjecutivo;

    private record ReporteTipoTab(string Key, string Label, string Icon);
    private static readonly List<ReporteTipoTab> ReporteTipos = new()
    {
        new("ejecutivo", "Ejecutivo Global", "bi-globe2"),
        new("operaciones", "Rutas y Órdenes", "bi-signpost-split"),
        new("cuadrillas", "Cuadrillas", "bi-people-fill"),
        new("suministros", "Cartera Suministros", "bi-droplet-half"),
        new("sector", "Sector / Manzana", "bi-grid-3x3-gap"),
        new("predial", "Informe Predial", "bi-house-door")
    };

    private string TituloActual => tipoActivo switch
    {
        "predial" => reportePredial?.Titulo ?? "INFORME TÉCNICO PREDIAL",
        "sector" => reporteSector?.Titulo ?? "DIAGNÓSTICO TERRITORIAL DE SECTOR",
        "operaciones" => reporteOperaciones?.Titulo ?? "INFORME OPERATIVO DE RUTAS Y ÓRDENES",
        "cuadrillas" => reporteCuadrillas?.Titulo ?? "INFORME DE DESEMPEÑO DE CUADRILLAS",
        "suministros" => reporteSuministros?.Titulo ?? "AUDITORÍA DE CARTERA DE SUMINISTROS",
        _ => reporteEjecutivo?.Titulo ?? "INFORME EJECUTIVO CONSOLIDADO SIG"
    };

    private string SubtituloActual => tipoActivo switch
    {
        "predial" => reportePredial?.Subtitulo ?? "Diagnóstico Individual de Inmueble",
        "sector" => $"Sector UV {(string.IsNullOrWhiteSpace(reporteSector?.UnidadVecinal) ? "Todas" : reporteSector!.UnidadVecinal)} / MZA {(string.IsNullOrWhiteSpace(reporteSector?.Manzana) ? "Todas" : reporteSector!.Manzana)}",
        "operaciones" => reporteOperaciones?.Subtitulo ?? "Órdenes de Corte y Reconexión",
        "cuadrillas" => reporteCuadrillas?.Subtitulo ?? "Productividad por Cortador y Reponedor",
        "suministros" => reporteSuministros?.Subtitulo ?? "Estado de Conexiones de Agua Potable",
        _ => reporteEjecutivo?.Subtitulo ?? "Inventario Territorial y Cobertura"
    };

    private string CodigoActual => tipoActivo switch
    {
        "predial" => reportePredial?.CodigoReporte ?? "RPT-PRED",
        "sector" => reporteSector?.CodigoReporte ?? "RPT-SEC",
        "operaciones" => reporteOperaciones?.CodigoReporte ?? "RPT-OPE",
        "cuadrillas" => reporteCuadrillas?.CodigoReporte ?? "RPT-CUA",
        "suministros" => reporteSuministros?.CodigoReporte ?? "RPT-SUM",
        _ => reporteEjecutivo?.CodigoReporte ?? "RPT-GSL"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !wasOpen)
        {
            wasOpen = true;
            if (!catalogosCargados) await CargarCatalogosAsync();

            if (SelectedLoteId.HasValue && SelectedLoteId.Value > 0)
            {
                tipoActivo = "predial";
                filtroLoteId = SelectedLoteId.Value;
            }
            else if (!string.IsNullOrWhiteSpace(SelectedUV) || !string.IsNullOrWhiteSpace(SelectedMZA))
            {
                tipoActivo = "sector";
                filtroSectorUv = SelectedUV ?? "";
                filtroSectorMza = SelectedMZA ?? "";
            }
            else
            {
                tipoActivo = "ejecutivo";
            }

            await GenerateReport();
        }
        else if (!IsOpen && wasOpen)
        {
            wasOpen = false;
        }
    }

    private async Task CargarCatalogosAsync()
    {
        catalogosCargados = true;
        try
        {
            var zonasTask = Http.GetFromJsonAsync<ZonasLookupDto>("/api/rutas-trabajo/zonas");
            var opsTask = Http.GetFromJsonAsync<List<OperarioMiniDto>>("/api/tracking/operarios");
            await Task.WhenAll(zonasTask, opsTask);
            var zonas = await zonasTask;
            if (zonas != null)
            {
                listaUvs = zonas.Uvs ?? new();
                listaManzanas = zonas.Manzanas ?? new();
            }
            listaOperarios = (await opsTask) ?? new();
        }
        catch { }
    }

    private async Task CambiarTipoReporte(string nuevoTipo)
    {
        tipoActivo = nuevoTipo;
        await GenerateReport();
    }

    private void OnSectorUvChanged() => filtroSectorMza = "";

    private string BuildQueryString(bool isPdf)
    {
        var qs = new List<string> { $"usuario={Uri.EscapeDataString(CurrentUserName)}" };

        switch (tipoActivo)
        {
            case "predial":
                return $"api/reportes/predio/{Math.Max(1, filtroLoteId)}{(isPdf ? "/pdf" : "")}?{string.Join("&", qs)}";
            case "sector":
                qs.Add($"uv={Uri.EscapeDataString(filtroSectorUv)}");
                qs.Add($"mza={Uri.EscapeDataString(filtroSectorMza)}");
                return $"api/reportes/sector{(isPdf ? "/pdf" : "")}?{string.Join("&", qs)}";
            case "operaciones":
                qs.Add($"tipo={Uri.EscapeDataString(filtroOpTipo)}");
                qs.Add($"estado={Uri.EscapeDataString(filtroOpEstado)}");
                qs.Add($"operario={Uri.EscapeDataString(filtroOpOperario)}");
                if (filtroDesde.HasValue) qs.Add($"desde={filtroDesde.Value:yyyy-MM-dd}");
                if (filtroHasta.HasValue) qs.Add($"hasta={filtroHasta.Value:yyyy-MM-dd}");
                return $"api/reportes/operaciones{(isPdf ? "/pdf" : "")}?{string.Join("&", qs)}";
            case "cuadrillas":
                qs.Add($"rol={Uri.EscapeDataString(filtroCuadrillaRol)}");
                if (filtroDesde.HasValue) qs.Add($"desde={filtroDesde.Value:yyyy-MM-dd}");
                if (filtroHasta.HasValue) qs.Add($"hasta={filtroHasta.Value:yyyy-MM-dd}");
                return $"api/reportes/cuadrillas{(isPdf ? "/pdf" : "")}?{string.Join("&", qs)}";
            case "suministros":
                if (!string.IsNullOrWhiteSpace(filtroSumEstado)) qs.Add($"estado={Uri.EscapeDataString(filtroSumEstado)}");
                if (!string.IsNullOrWhiteSpace(filtroSumUv)) qs.Add($"uv={Uri.EscapeDataString(filtroSumUv)}");
                if (filtroSumSoloVerificados) qs.Add("soloVerificados=true");
                qs.Add("limite=250");
                return $"api/reportes/suministros{(isPdf ? "/pdf" : "")}?{string.Join("&", qs)}";
            default:
                return $"api/reportes/ejecutivo-global{(isPdf ? "/pdf" : "")}?{string.Join("&", qs)}";
        }
    }

    private async Task GenerateReport()
    {
        isLoading = true;
        switch (tipoActivo)
        {
            case "predial": reportePredial = null; break;
            case "sector": reporteSector = null; break;
            case "operaciones": reporteOperaciones = null; break;
            case "cuadrillas": reporteCuadrillas = null; break;
            case "suministros": reporteSuministros = null; break;
            default: reporteEjecutivo = null; break;
        }
        try
        {
            var url = BuildQueryString(false);
            switch (tipoActivo)
            {
                case "predial":
                    reportePredial = await Http.GetFromJsonAsync<ReportePredialModel>(url);
                    break;
                case "sector":
                    reporteSector = await Http.GetFromJsonAsync<ReporteSectorModel>(url);
                    break;
                case "operaciones":
                    reporteOperaciones = await Http.GetFromJsonAsync<ReporteOperacionesRutasModel>(url);
                    break;
                case "cuadrillas":
                    reporteCuadrillas = await Http.GetFromJsonAsync<ReporteDesempenoCuadrillasModel>(url);
                    break;
                case "suministros":
                    reporteSuministros = await Http.GetFromJsonAsync<ReporteEstadoSuministrosModel>(url);
                    break;
                default:
                    reporteEjecutivo = await Http.GetFromJsonAsync<ReporteEjecutivoGlobalModel>(url);
                    break;
            }
        }
        catch (Exception ex)
        {
            ErrorService.FromException(ex, "generación de reporte técnico", () => GenerateReport());
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DownloadServerPdf()
    {
        try
        {
            isLoading = true;
            var pdfUrl = BuildQueryString(true);
            var filename = $"Reporte_{tipoActivo}_{DateTime.UtcNow:yyyyMMdd_HHmm}.pdf";
            var pdfBytes = await Http.GetByteArrayAsync(pdfUrl);
            await JS.MapaAsync("arquis.downloadFile", filename, Convert.ToBase64String(pdfBytes), "application/pdf");
        }
        catch (Exception ex)
        {
            ErrorService.FromException(ex, "descarga del dictamen técnico oficial en PDF", () => DownloadServerPdf());
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DownloadCsv()
    {
        var sb = new StringBuilder();
        static string Csv(object? val)
        {
            var s = val?.ToString() ?? "";
            return $"\"{s.Replace("\"", "\"\"")}\"";
        }

        switch (tipoActivo)
        {
            case "predial" when reportePredial != null:
                sb.AppendLine("CodigoReporte,IdLote,NumeroLote,UV,Manzana,Titular,CodigoSuministro,CondicionOperativa,CoberturaManzanaPct");
                sb.AppendLine(string.Join(",", Csv(reportePredial.CodigoReporte), reportePredial.IdLote, Csv(reportePredial.NumeroLote), Csv(reportePredial.UnidadVecinal), Csv(reportePredial.Manzana), Csv(reportePredial.Titular), Csv(reportePredial.CodigoSuministro), Csv(reportePredial.CondicionOperativa), reportePredial.PorcentajeCoberturaManzana));
                break;
            case "sector" when reporteSector != null:
                sb.AppendLine("IdLote,NumeroLote,EstadoServicio,Titular,CodigoSuministro,Condicion");
                foreach (var p in reporteSector.Predios)
                    sb.AppendLine(string.Join(",", p.IdLote, Csv(p.NumeroLote), Csv(p.EstadoServicio), Csv(p.Titular), Csv(p.CodigoSuministro), Csv(p.Condicion)));
                break;
            case "operaciones" when reporteOperaciones != null:
                sb.AppendLine("CodigoRuta,Operario,TipoRuta,Orden,CodigoSuministro,Titular,Direccion,Estado,EstadoFinal,DistanciaAntifraudeMetros,MontoDeuda");
                foreach (var d in reporteOperaciones.DetalleParadas)
                    sb.AppendLine(string.Join(",", Csv(d.CodigoRuta), Csv(d.Operario), Csv(d.TipoRuta), d.Orden, Csv(d.CodigoSuministro), Csv(d.Titular), Csv(d.Direccion), Csv(d.Estado), Csv(d.EstadoFinal), d.DistanciaAntifraudeMetros?.ToString("F1") ?? "", d.MontoDeuda?.ToString("F2") ?? "0"));
                break;
            case "cuadrillas" when reporteCuadrillas != null:
                sb.AppendLine("OperarioId,NombreOperario,Rol,RutasAsignadas,RutasCompletadas,ParadasTotales,Ejecutadas,Observadas,Pendientes,CumplimientoPct,DistanciaKm,GpsPromedioMetros");
                foreach (var c in reporteCuadrillas.Cuadrillas)
                    sb.AppendLine(string.Join(",", Csv(c.OperarioId), Csv(c.NombreOperario), Csv(c.Rol), c.RutasAsignadas, c.RutasCompletadas, c.ParadasTotales, c.Ejecutadas, c.Observadas, c.Pendientes, c.PorcentajeCumplimiento, c.DistanciaTotalKm, c.PrecisionGpsPromedioMetros?.ToString("F1") ?? ""));
                break;
            case "suministros" when reporteSuministros != null:
                sb.AppendLine("IdCodigo,CodigoFijo,CodigoSig,Titular,UV,Manzana,Lote,EstadoTexto,Verificado,FechaCambioEstado");
                foreach (var s in reporteSuministros.Suministros)
                    sb.AppendLine(string.Join(",", s.IdCodigo, Csv(s.CodigoFijo), Csv(s.CodigoSig), Csv(s.Titular), Csv(s.UnidadVecinal), Csv(s.Manzana), Csv(s.NumeroLote), Csv(s.EstadoTexto), s.EstadoVerificado ? "Si" : "No", s.FechaCambioEstado.ToString("yyyy-MM-dd HH:mm")));
                break;
            case "ejecutivo" when reporteEjecutivo != null:
                sb.AppendLine("UnidadVecinal,Manzanas,TotalLotes,LotesConAgua,CoberturaPct,CuentasParaCorte,CuentasCortadas,CuentasParaReconexion");
                foreach (var u in reporteEjecutivo.ResumenPorUv)
                    sb.AppendLine(string.Join(",", Csv(u.UnidadVecinal), u.TotalManzanas, u.TotalLotes, u.LotesConAgua, u.CoberturaPct, u.CuentasParaCorte, u.CuentasCortadas, u.CuentasParaReconexion));
                break;
            default:
                return;
        }

        var bom = new byte[] { 0xEF, 0xBB, 0xBF };
        var body = Encoding.UTF8.GetBytes(sb.ToString());
        var csvBytes = bom.Concat(body).ToArray();
        await JS.MapaAsync("arquis.downloadFile", $"Reporte_{tipoActivo}_{DateTime.UtcNow:yyyyMMdd_HHmm}.csv", Convert.ToBase64String(csvBytes), "text/csv;charset=utf-8");
    }

    private async Task PrintReport() => await JS.InvokeVoidAsync("window.print");

    private async Task CopyReportText()
    {
        isCopied = true;
        var text = $"{TituloActual} ({CodigoActual})\n{SubtituloActual}\n\n" + tipoActivo switch
        {
            "predial" when reportePredial != null => reportePredial.ResumenEjecutivo,
            "sector" when reporteSector != null => reporteSector.DiagnosticoSituacional,
            "operaciones" when reporteOperaciones != null => reporteOperaciones.ResumenEjecutivo,
            "cuadrillas" when reporteCuadrillas != null => reporteCuadrillas.ResumenEjecutivo,
            "suministros" when reporteSuministros != null => reporteSuministros.ResumenEjecutivo,
            "ejecutivo" when reporteEjecutivo != null => reporteEjecutivo.ResumenEjecutivo,
            _ => ""
        };

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        await Task.Delay(2000);
        isCopied = false;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _ = CloseModal();
    }

    private async Task CloseModal()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

