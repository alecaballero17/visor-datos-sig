@inject HttpClient Http
@inject IJSRuntime JS
@inject IUserFriendlyErrorService ErrorService

@if (IsOpen)
{
    <div class="report-modal-backdrop anim-fade-in"
         role="dialog"
         aria-modal="true"
         aria-labelledby="report-modal-title"
         tabindex="-1"
         @onkeydown="HandleKeyDown"
         @onclick="CloseModal">
        <div class="report-modal-card shadow-2xl anim-scale-in" @onclick:stopPropagation="true">
            <!-- Barra superior del modal (no se imprime) -->
            <div class="modal-card-header d-flex justify-content-between align-items-center p-3 border-bottom no-print">
                <div class="d-flex align-items-center gap-2">
                    <span class="report-header-badge bg-primary-subtle text-primary border border-primary-subtle" aria-hidden="true">
                        <i class="bi bi-file-earmark-bar-graph-fill fs-5"></i>
                    </span>
                    <div>
                        <h5 class="mb-0 fw-bold" id="report-modal-title">Emisión de Informe Técnico SIG</h5>
                        <small class="text-muted">Documento estructurado para exposición y auditoría</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm d-flex align-items-center gap-1"
                            @onclick="DownloadServerPdf"
                            title="Descargar documento PDF oficial con vectores cartográficos de alta calidad">
                        <i class="bi bi-file-earmark-pdf-fill"></i>
                        <span>Descargar PDF Oficial</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="PrintReport" title="Vista preliminar de impresión">
                        <i class="bi bi-printer me-1"></i>Imprimir
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="CopyReportText" title="Copiar informe al portapapeles">
                        <i class="bi @(isCopied ? "bi-check2 text-success" : "bi-clipboard") me-1"></i>
                        @(isCopied ? "¡Copiado!" : "Copiar")
                    </button>
                    <a href="/bitacora" class="btn btn-sm btn-outline-info rounded-pill px-3 text-decoration-none" title="Ir al apartado dedicado de Bitácora">
                        <i class="bi bi-journal-text me-1"></i>Apartado Bitácora
                    </a>
                    <button type="button" class="btn-close ms-2" @onclick="CloseModal" aria-label="Cerrar modal de reporte"></button>
                </div>
            </div>

            <!-- Contenido del modal -->
            <div class="modal-card-body p-3 p-md-4">
                @if (isLoading)
                {
                    <div class="py-5 text-center text-muted">
                        <div class="spinner-border text-primary mb-2" role="status"></div>
                        <div class="fw-semibold">Generando informe técnico y registrando en bitácora...</div>
                    </div>
                }
                else
                {
                    <!-- HOJA FORMAL DEL REPORTE (IMPRIMIBLE) -->
                    <div class="formal-report-sheet p-4 bg-white rounded border shadow-sm">
                        <!-- Membrete Institucional -->
                        <div class="report-header-banner pb-3 mb-4 border-bottom d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge bg-primary text-white text-uppercase px-2 py-1 mb-1" style="font-size:0.68rem; letter-spacing:0.06em;">
                                    VISOR DE DATOS SIG · GOBIERNO LOCAL & COOPERATIVA
                                </span>
                                <h4 class="fw-black text-dark mb-0 text-uppercase" style="letter-spacing: -0.02em;">
                                    @(reportePredial?.Titulo ?? reporteSector?.Titulo ?? "INFORME TÉCNICO DE CATASTRO")
                                </h4>
                                <span class="text-secondary small">
                                    @(reportePredial?.Subtitulo ?? "Diagnóstico de Infraestructura y Cobertura de Agua Potable")
                                </span>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light text-dark border font-monospace d-block mb-1" style="font-size: 0.78rem;">
                                    @(reportePredial?.CodigoReporte ?? reporteSector?.CodigoReporte ?? "RPT-SIG-2026")
                                </span>
                                <small class="text-muted d-block" style="font-size: 0.72rem;">
                                    Emisión: @(DateTime.Now.ToString("dd/MM/yyyy HH:mm"))
                                </small>
                                <small class="text-muted d-block" style="font-size: 0.72rem;">
                                    Emisor: @(reportePredial?.UsuarioEmisor ?? reporteSector?.UsuarioEmisor ?? "Usuario SIG")
                                </small>
                            </div>
                        </div>

                        @if (reportePredial != null)
                        {
                            <!-- REPORTE DE UN PREDIO / CASA -->
                            <div class="report-section mb-4">
                                <h6 class="section-heading text-uppercase text-primary fw-bold mb-3">
                                    <i class="bi bi-house-door-fill me-1"></i>1. Identificación y Localización del Inmueble
                                </h6>
                                <div class="row g-2 mb-3">
                                    <div class="col-sm-3 col-6">
                                        <div class="p-2 border rounded bg-light">
                                            <span class="small text-muted d-block" style="font-size:0.7rem">N° DE LOTE</span>
                                            <span class="fw-bold fs-6 text-dark">Lote @reportePredial.NumeroLote</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-3 col-6">
                                        <div class="p-2 border rounded bg-light">
                                            <span class="small text-muted d-block" style="font-size:0.7rem">MANZANA (MZA)</span>
                                            <span class="fw-bold fs-6 text-dark">MZA @reportePredial.Manzana</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-3 col-6">
                                        <div class="p-2 border rounded bg-light">
                                            <span class="small text-muted d-block" style="font-size:0.7rem">UNIDAD VECINAL (UV)</span>
                                            <span class="fw-bold fs-6 text-dark">UV @reportePredial.UnidadVecinal</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-3 col-6">
                                        <div class="p-2 border rounded bg-light">
                                            <span class="small text-muted d-block" style="font-size:0.7rem">CLASIFICACIÓN</span>
                                            <span class="fw-bold fs-6 text-primary">@reportePredial.ClasificacionUrbana</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-2 border rounded bg-light small mb-2 d-flex justify-content-between">
                                    <span><strong>Coordenadas GPS:</strong> @reportePredial.CoordenadasDisplay</span>
                                    <span><strong>Sector:</strong> @reportePredial.Sector</span>
                                </div>
                            </div>

                            <!-- Diagnóstico de Suministro de Agua Potable -->
                            <div class="report-section mb-4">
                                <h6 class="section-heading text-uppercase text-primary fw-bold mb-3">
                                    <i class="bi bi-droplet-half me-1"></i>2. Diagnóstico del Suministro de Agua Potable
                                </h6>
                                <div class="p-3 rounded border @(reportePredial.TieneAgua ? "bg-success-subtle bg-opacity-25 border-success" : "bg-warning-subtle bg-opacity-25 border-warning") mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi @(reportePredial.TieneAgua ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-warning") fs-4"></i>
                                            <h6 class="fw-bold mb-0 @(reportePredial.TieneAgua ? "text-success" : "text-warning-emphasis")">
                                                @reportePredial.EstadoTexto
                                            </h6>
                                        </div>
                                        <span class="badge @(reportePredial.TieneAgua ? "bg-success text-white" : "bg-warning text-dark")">
                                            @reportePredial.CondicionOperativa
                                        </span>
                                    </div>
                                    <div class="row g-2 small">
                                        <div class="col-sm-6">
                                            <strong>Titular Registrado:</strong> @(reportePredial.Titular ?? "No asignado")
                                        </div>
                                        <div class="col-sm-6">
                                            <strong>Código de Suministro / Cuenta:</strong> #@(reportePredial.CodigoSuministro ?? "—")
                                        </div>
                                        <div class="col-sm-6">
                                            <strong>Clave SIG Municipal:</strong> @reportePredial.CodigoSig
                                        </div>
                                        <div class="col-sm-6">
                                            <strong>Ubicación de Acometida:</strong> @reportePredial.UbicacionToma
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Análisis Territorial y Contexto -->
                            <div class="report-section mb-4">
                                <h6 class="section-heading text-uppercase text-primary fw-bold mb-3">
                                    <i class="bi bi-pie-chart-fill me-1"></i>3. Análisis Territorial y Contexto de la Manzana
                                </h6>
                                <div class="row g-2 mb-3">
                                    <div class="col-sm-4 text-center">
                                        <div class="p-2 border rounded bg-light">
                                            <span class="small text-muted d-block">Total Lotes en Manzana</span>
                                            <span class="fs-5 fw-bold text-dark">@reportePredial.TotalLotesManzana</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-4 text-center">
                                        <div class="p-2 border rounded bg-light">
                                            <span class="small text-muted d-block">Lotes Con Agua</span>
                                            <span class="fs-5 fw-bold text-success">@reportePredial.LotesConAguaManzana</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-4 text-center">
                                        <div class="p-2 border rounded bg-light">
                                            <span class="small text-muted d-block">Cobertura del Entorno</span>
                                            <span class="fs-5 fw-bold text-primary">@reportePredial.PorcentajeCoberturaManzana%</span>
                                        </div>
                                    </div>
                                </div>
                                <p class="small text-secondary mb-0">
                                    <strong>Factibilidad Técnica:</strong> @reportePredial.FactibilidadHidraulica
                                </p>
                            </div>

                            <!-- Dictamen Ejecutivo y Recomendaciones -->
                            <div class="report-section mb-4">
                                <h6 class="section-heading text-uppercase text-primary fw-bold mb-2">
                                    <i class="bi bi-card-checklist me-1"></i>4. Dictamen Ejecutivo y Conclusiones
                                </h6>
                                <div class="p-3 border rounded bg-light small mb-3 text-secondary lh-base">
                                    @reportePredial.ResumenEjecutivo
                                </div>

                                <h6 class="small fw-bold text-dark text-uppercase mb-2">Recomendaciones Operativas:</h6>
                                <ul class="small text-secondary mb-0 ps-3">
                                    @foreach (var rec in reportePredial.Recomendaciones)
                                    {
                                        <li class="mb-1">@rec</li>
                                    }
                                </ul>
                            </div>
                        }
                        else if (reporteSector != null)
                        {
                            <!-- REPORTE DE UN SECTOR / BARRIO -->
                            <div class="report-section mb-4">
                                <h6 class="section-heading text-uppercase text-primary fw-bold mb-3">
                                    <i class="bi bi-grid-3x3-gap-fill me-1"></i>1. Delimitación y Resumen del Sector
                                </h6>
                                <div class="row g-2 mb-3">
                                    <div class="col-sm-3 col-6">
                                        <div class="p-2 border rounded bg-light text-center">
                                            <span class="small text-muted d-block">UNIDAD VECINAL</span>
                                            <span class="fw-bold fs-5 text-dark">UV @reporteSector.UnidadVecinal</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-3 col-6">
                                        <div class="p-2 border rounded bg-light text-center">
                                            <span class="small text-muted d-block">MANZANA</span>
                                            <span class="fw-bold fs-5 text-dark">MZA @reporteSector.Manzana</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-3 col-6">
                                        <div class="p-2 border rounded bg-light text-center">
                                            <span class="small text-muted d-block">TASA DE COBERTURA</span>
                                            <span class="fw-bold fs-5 text-primary">@reporteSector.PorcentajeCobertura%</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-3 col-6">
                                        <div class="p-2 border rounded bg-light text-center">
                                            <span class="small text-muted d-block">NIVEL CONSOLIDACIÓN</span>
                                            <span class="fw-bold fs-5 text-success">@reporteSector.IndiceConsolidacion</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="p-3 border rounded bg-light small mb-3 text-secondary lh-base">
                                    <strong class="text-dark d-block mb-1">Diagnóstico Situacional del Sector:</strong>
                                    @reporteSector.DiagnosticoSituacional
                                </div>
                            </div>

                            <!-- Tabla de Lotes del Sector -->
                            <div class="report-section mb-4">
                                <h6 class="section-heading text-uppercase text-primary fw-bold mb-2">
                                    <i class="bi bi-table me-1"></i>2. Censo Detallado de Predios de la Manzana (@reporteSector.TotalPredios predios)
                                </h6>
                                <div class="table-responsive border rounded" style="max-height: 280px; overflow-y: auto;">
                                    <table class="table table-sm table-striped mb-0 small">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>N° Lote</th>
                                                <th>Estado del Servicio</th>
                                                <th>Titular del Suministro</th>
                                                <th>Código Cuenta</th>
                                                <th>Condición</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var predio in reporteSector.Predios)
                                            {
                                                <tr>
                                                    <td class="fw-bold">Lote @predio.NumeroLote</td>
                                                    <td>
                                                        <span class="badge @(predio.TieneAgua ? "bg-success" : "bg-danger")">
                                                            @predio.EstadoServicio
                                                        </span>
                                                    </td>
                                                    <td>@(predio.Titular ?? "—")</td>
                                                    <td class="font-monospace">#(predio.CodigoSuministro ?? "—")</td>
                                                    <td>@predio.Condicion</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Recomendaciones -->
                            <div class="report-section mb-4">
                                <h6 class="section-heading text-uppercase text-primary fw-bold mb-2">
                                    <i class="bi bi-check2-circle me-1"></i>3. Recomendaciones Técnicas para el Sector
                                </h6>
                                <ul class="small text-secondary mb-0 ps-3">
                                    @foreach (var rec in reporteSector.RecomendacionesTecnicas)
                                    {
                                        <li class="mb-1">@rec</li>
                                    }
                                </ul>
                            </div>
                        }

                        <!-- Pie del Reporte con firmas institucionales -->
                        <div class="report-footer pt-4 mt-4 border-top">
                            <div class="row text-center text-muted small">
                                <div class="col-6">
                                    <div class="signature-line mx-auto mb-1" style="width: 160px; border-bottom: 1px solid #94a3b8; height: 35px;"></div>
                                    <span>Responsable Técnico de Catastro</span>
                                </div>
                                <div class="col-6">
                                    <div class="signature-line mx-auto mb-1" style="width: 160px; border-bottom: 1px solid #94a3b8; height: 35px;"></div>
                                    <span>División de Servicios y Distribución</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-card-footer p-3 border-top d-flex justify-content-between align-items-center no-print">
                <a href="/bitacora" class="btn btn-sm btn-outline-secondary rounded-pill px-3 text-decoration-none">
                    <i class="bi bi-journal-check me-1"></i>Apartado Bitácora de Auditoría
                </a>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-flex align-items-center gap-1" @onclick="DownloadServerPdf">
                        <i class="bi bi-file-earmark-pdf-fill"></i>
                        <span>Descargar PDF Oficial</span>
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" @onclick="CloseModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter] public int? SelectedLoteId { get; set; }
    [Parameter] public string? SelectedUV { get; set; }
    [Parameter] public string? SelectedMZA { get; set; }
    [Parameter] public string CurrentUserName { get; set; } = "Usuario SIG";

    private bool isLoading = false;
    private bool isCopied = false;

    private ReportePredialModel? reportePredial;
    private ReporteSectorModel? reporteSector;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            await GenerateReport();
        }
    }

    private async Task GenerateReport()
    {
        isLoading = true;
        reportePredial = null;
        reporteSector = null;

        try
        {
            if (SelectedLoteId.HasValue && SelectedLoteId.Value > 0)
            {
                var url = $"api/reportes/predio/{SelectedLoteId.Value}?usuario={Uri.EscapeDataString(CurrentUserName)}";
                reportePredial = await Http.GetFromJsonAsync<ReportePredialModel>(url);
            }
            else
            {
                var uvVal = SelectedUV ?? "";
                var mzaVal = SelectedMZA ?? "";
                var url = $"api/reportes/sector?uv={Uri.EscapeDataString(uvVal)}&mza={Uri.EscapeDataString(mzaVal)}&usuario={Uri.EscapeDataString(CurrentUserName)}";
                try
                {
                    reporteSector = await Http.GetFromJsonAsync<ReporteSectorModel>(url);
                }
                catch
                {
                    // Fallback para traer el primer sector disponible
                    var fallbackUrl = $"api/reportes/sector?usuario={Uri.EscapeDataString(CurrentUserName)}";
                    reporteSector = await Http.GetFromJsonAsync<ReporteSectorModel>(fallbackUrl);
                }
            }
        }
        catch (Exception ex)
        {
            ErrorService.FromException(ex, "generación de informe técnico oficial", () => GenerateReport());
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DownloadServerPdf()
    {
        try
        {
            string pdfUrl;
            if (SelectedLoteId.HasValue && SelectedLoteId.Value > 0)
            {
                pdfUrl = $"api/reportes/predio/{SelectedLoteId.Value}/pdf?usuario={Uri.EscapeDataString(CurrentUserName)}";
            }
            else
            {
                var uvVal = SelectedUV ?? "";
                var mzaVal = SelectedMZA ?? "";
                pdfUrl = $"api/reportes/sector/pdf?uv={Uri.EscapeDataString(uvVal)}&mza={Uri.EscapeDataString(mzaVal)}&usuario={Uri.EscapeDataString(CurrentUserName)}";
            }

            var fullUrl = Http.BaseAddress != null
                ? new Uri(Http.BaseAddress, pdfUrl).ToString()
                : pdfUrl;

            await JS.InvokeVoidAsync("open", fullUrl, "_blank");
        }
        catch (Exception ex)
        {
            ErrorService.FromException(ex, "descarga del dictamen técnico oficial en PDF", () => DownloadServerPdf());
        }
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task CopyReportText()
    {
        isCopied = true;
        string text = "";

        if (reportePredial != null)
        {
            text = $"INFORME TÉCNICO PREDIAL - {reportePredial.CodigoReporte}\n" +
                   $"Lote N° {reportePredial.NumeroLote} · MZA {reportePredial.Manzana} · UV {reportePredial.UnidadVecinal}\n" +
                   $"Servicio de Agua: {reportePredial.EstadoTexto}\n" +
                   $"Titular: {reportePredial.Titular}\n" +
                   $"Código Suministro: {reportePredial.CodigoSuministro}\n" +
                   $"Cobertura en Manzana: {reportePredial.PorcentajeCoberturaManzana}%\n" +
                   $"Dictamen: {reportePredial.ResumenEjecutivo}";
        }
        else if (reporteSector != null)
        {
            text = $"DIAGNÓSTICO DEL SECTOR - UV {reporteSector.UnidadVecinal} / MZA {reporteSector.Manzana}\n" +
                   $"Total Predios: {reporteSector.TotalPredios}\n" +
                   $"Con Suministro: {reporteSector.PrediosConServicio} ({reporteSector.PorcentajeCobertura}%)\n" +
                   $"Sin Suministro: {reporteSector.PrediosSinServicio}\n" +
                   $"Diagnóstico: {reporteSector.DiagnosticoSituacional}";
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        await Task.Delay(2000);
        isCopied = false;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _ = CloseModal();
        }
    }

    private async Task CloseModal()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
