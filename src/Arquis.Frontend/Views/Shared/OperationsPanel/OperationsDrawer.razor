@using Arquis.Frontend.Views.Shared.OperationsPanel.Views
@inject IJSRuntime JS

<!-- Backdrop oscuro con desenfoque suave -->
<div class="operations-drawer-backdrop @((IsOpen && !isPeekingMap) ? "open" : "")" @onclick="CloseDrawer"></div>

@if (IsOpen && isPeekingMap)
{
    <div class="map-pick-banner anim-fade-in-up" role="status">
        <i class="bi bi-geo-alt-fill text-warning"></i>
        <span>@(isPickingDeparturePoint ? "Haz clic en el mapa para fijar el punto de partida" : "Vista del mapa temporal (panel minimizado)")</span>
        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1" @onclick="RestoreFromPeek">
            <i class="bi bi-layout-sidebar-inset-reverse me-1"></i>Volver al Panel
        </button>
    </div>
}

<!-- Panel Retráctil Lateral (Sliding Drawer) -->
<aside class="operations-drawer @((IsOpen && !isPeekingMap) ? "open" : "")" aria-label="Panel de Operaciones y Opciones">
    <!-- Encabezado del Panel Retráctil -->
    <div class="drawer-header">
        <div class="d-flex align-items-center gap-2">
            <div class="p-2 rounded bg-primary text-white d-flex align-items-center justify-content-center" style="width:34px; height:34px;">
                <i class="bi bi-grid-1x2-fill"></i>
            </div>
            <div>
                <h6 class="mb-0 fw-bold text-dark">Centro de Asignación de Trabajos</h6>
                <small class="text-muted">Operaciones SIG · <strong>Cortadores</strong> y <strong>Reconectores</strong></small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" @onclick="PeekMap" title="Ocultar temporalmente el panel para ver el mapa">
                <i class="bi bi-map me-1"></i>Ver mapa
            </button>
            <button type="button" class="btn-close ms-1" @onclick="CloseDrawer" aria-label="Cerrar panel"></button>
        </div>
    </div>

    <!-- Barra de Navegación por Categorías (Modular) -->
    <nav class="drawer-nav-tabs">
        <button type="button" class="drawer-tab-btn @(currentTab == "operadores" ? "active" : "")" @onclick='() => SetTab("operadores")'>
            <i class="bi bi-people-fill text-secondary"></i>
            <span>Cuadrilla (Roles)</span>
        </button>
        <button type="button" class="drawer-tab-btn @(currentTab == "cortes" ? "active" : "")" @onclick='() => SetTab("cortes")'>
            <i class="bi bi-slash-circle text-danger"></i>
            <span>Cortes (Cortadores)</span>
        </button>
        <button type="button" class="drawer-tab-btn @(currentTab == "reconexiones" ? "active" : "")" @onclick='() => SetTab("reconexiones")'>
            <i class="bi bi-droplet-fill text-primary"></i>
            <span>Reconexiones (Reconectores)</span>
        </button>
        <button type="button" class="drawer-tab-btn @(currentTab == "tracking" ? "active" : "")" @onclick='() => SetTab("tracking")'>
            <i class="bi bi-broadcast"></i>
            <span>Monitoreo GPS</span>
        </button>
        <button type="button" class="drawer-tab-btn @(currentTab == "configuracion" ? "active" : "")" @onclick='() => SetTab("configuracion")'>
            <i class="bi bi-sliders"></i>
            <span>Opciones</span>
        </button>
    </nav>

    <!-- Cuerpo del Panel: Renderizado de la Vista Individual Modular -->
    <div class="drawer-body">
        @if (currentTab == "operadores")
        {
            <OperadoresListView OnAsignarCorte="IrACortesParaOperario"
                                OnAsignarReconexion="IrAReconexionParaOperario"
                                OnVerHistorial="IrAMonitoreoParaOperario" />
        }
        else if (currentTab == "cortes")
        {
            <AsignarCortesView @ref="cortesView"
                               PreselectedOperarioId="@selectedOperarioId"
                               OnVerRutaEnMapa="CerrarParaVerMapa"
                               OnPickingMapChanged="HandleMapPickChanged" />
        }
        else if (currentTab == "reconexiones")
        {
            <AsignarReconexionesView @ref="reconexionesView"
                                     PreselectedOperarioId="@selectedOperarioId"
                                     OnVerRutaEnMapa="CerrarParaVerMapa"
                                     OnPickingMapChanged="HandleMapPickChanged" />
        }
        else if (currentTab == "tracking")
        {
            <MonitoreoGpsView PreselectedOperarioId="@selectedOperarioId" />
        }
        else if (currentTab == "configuracion")
        {
            <ConfiguracionVisorView />
        }
    </div>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string currentTab = "operadores";
    private string selectedOperarioId = "";
    private bool isPeekingMap = false;
    private bool isPickingDeparturePoint = false;
    private AsignarCortesView? cortesView;
    private AsignarReconexionesView? reconexionesView;

    public void OpenInTab(string tab)
    {
        currentTab = tab;
        isPeekingMap = false;
        isPickingDeparturePoint = false;
        IsOpen = true;
        IsOpenChanged.InvokeAsync(true);
    }

    private void SetTab(string tab)
    {
        currentTab = tab;
    }

    private void PeekMap()
    {
        isPeekingMap = true;
        isPickingDeparturePoint = false;
    }

    private async Task RestoreFromPeek()
    {
        isPeekingMap = false;
        isPickingDeparturePoint = false;
        cortesView?.CancelMapPick();
        reconexionesView?.CancelMapPick();
        await JS.MapaAsync("arquis.cancelDeparturePointSelection");
    }

    private void HandleMapPickChanged(bool isPicking)
    {
        isPickingDeparturePoint = isPicking;
        isPeekingMap = isPicking;
    }

    private async Task CloseDrawer()
    {
        isPeekingMap = false;
        isPickingDeparturePoint = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private void IrACortesParaOperario(string operarioId)
    {
        selectedOperarioId = operarioId;
        currentTab = "cortes";
    }

    private void IrAReconexionParaOperario(string operarioId)
    {
        selectedOperarioId = operarioId;
        currentTab = "reconexiones";
    }

    private void IrAMonitoreoParaOperario(string operarioId)
    {
        selectedOperarioId = operarioId;
        currentTab = "tracking";
    }

    private async Task CerrarParaVerMapa(object _)
    {
        await CloseDrawer();
    }
}
