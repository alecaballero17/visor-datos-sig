@inject HttpClient Http
@inject IJSRuntime JS
<RealtimeUpdates OnUpdate="CargarOperariosSilencioso" />

<div class="drawer-view-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i>
                <span>Cuadrilla y Roles de Trabajo</span>
            </h6>
            <small class="text-muted">Personal técnico clasificado en <strong>Cortadores</strong> y <strong>Reconectores</strong></small>
        </div>
        <div class="d-flex align-items-center gap-1">
            <span class="badge @(operariosActivos.Count > 0 ? "bg-success" : "bg-secondary")" style="font-size:0.7rem;">
                <span class="spinner-grow spinner-grow-sm me-1" style="width:6px; height:6px;" role="status" aria-hidden="true"></span>
                @operariosActivos.Count en vivo
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" @onclick="CargarOperarios" title="Actualizar ahora">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeFeedback))
    {
        <div class="alert alert-info alert-dismissible fade show py-2 px-3 small mb-3 shadow-sm d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill text-primary"></i>
            <span class="flex-grow-1">@mensajeFeedback</span>
            <button type="button" class="btn-close py-2 px-2" @onclick="() => mensajeFeedback = null"></button>
        </div>
    }

    <!-- Métricas en Vivo de Cuadrilla divididas por los 2 Roles -->
    <div class="row g-2 mb-3">
        <div class="col-4">
            <div class="p-2 border rounded bg-white text-center shadow-sm h-100">
                <span class="small text-muted d-block" style="font-size:0.68rem;">Total Cuadrilla</span>
                <strong class="fs-5 text-dark">@operarios.Count</strong>
                <small class="d-block text-muted" style="font-size:0.65rem;">@operariosActivos.Count activos</small>
            </div>
        </div>
        <div class="col-4">
            <div class="metric-card-cortador text-center h-100">
                <span class="small text-danger d-block fw-semibold" style="font-size:0.68rem;">
                    <i class="bi bi-slash-circle me-1"></i>Cortadores
                </span>
                <strong class="fs-5 text-danger">@TotalCortadores</strong>
                <small class="d-block text-muted" style="font-size:0.65rem;">@CortadoresActivos en línea</small>
            </div>
        </div>
        <div class="col-4">
            <div class="metric-card-reconector text-center h-100">
                <span class="small text-primary d-block fw-semibold" style="font-size:0.68rem;">
                    <i class="bi bi-droplet-fill me-1"></i>Reconectores
                </span>
                <strong class="fs-5 text-primary">@TotalReconectores</strong>
                <small class="d-block text-muted" style="font-size:0.65rem;">@ReconectoresActivos en línea</small>
            </div>
        </div>
    </div>

    <!-- Filtros de Rol y Búsqueda -->
    <div class="d-flex flex-wrap gap-1 align-items-center mb-2">
        <button type="button" class="role-filter-pill @(filtroRol == "todos" ? "active-all" : "")" @onclick='() => filtroRol = "todos"'>
            Todos (@operarios.Count)
        </button>
        <button type="button" class="role-filter-pill @(filtroRol == "Cortador" ? "active-cortador" : "")" @onclick='() => filtroRol = "Cortador"'>
            <i class="bi bi-slash-circle"></i> Cortadores (@TotalCortadores)
        </button>
        <button type="button" class="role-filter-pill @(filtroRol == "Reconector" ? "active-reconector" : "")" @onclick='() => filtroRol = "Reconector"'>
            <i class="bi bi-droplet-fill"></i> Reconectores (@TotalReconectores)
        </button>
        <div class="ms-auto form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="filtroSoloEnLinea" @bind="soloSoloEnLinea" />
            <label class="form-check-label small text-muted" for="filtroSoloEnLinea" style="font-size:0.72rem;">En línea</label>
        </div>
    </div>

    <!-- Buscador Reactivo de Operarios -->
    <div class="input-group input-group-sm mb-3">
        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control border-start-0" placeholder="Buscar por nombre, usuario o rol..." @bind="filtroTexto" @bind:event="oninput" />
        @if (!string.IsNullOrEmpty(filtroTexto))
        {
            <button class="btn btn-outline-secondary" type="button" @onclick="() => filtroTexto = string.Empty">
                <i class="bi bi-x"></i>
            </button>
        }
    </div>

    @if (isLoading && operarios.Count == 0)
    {
        <div class="py-5 text-center text-muted">
            <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
            <div class="small fw-semibold">Consultando cuadrillas en campo...</div>
        </div>
    }
    else if (OperariosFiltrados.Count == 0)
    {
        <div class="text-center py-5 border rounded bg-white shadow-sm">
            <i class="bi bi-person-x text-muted fs-1 mb-2 d-block"></i>
            <div class="fw-semibold text-dark">No se encontraron trabajadores</div>
            <small class="text-muted">Ningún técnico coincide con los filtros de rol o búsqueda aplicados.</small>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var op in OperariosFiltrados)
            {
                var activo = operariosActivos.FirstOrDefault(x => string.Equals(x.OperarioId, op.OperarioId, StringComparison.OrdinalIgnoreCase));
                var isOnline = op.EnLinea || activo != null;
                var lat = activo?.Latitud ?? op.Latitud;
                var lng = activo?.Longitud ?? op.Longitud;
                var vel = activo?.Velocidad ?? op.Velocidad;
                var rumbo = activo?.Rumbo ?? op.Rumbo;
                var bat = activo?.Bateria ?? op.Bateria;
                var isCortador = string.Equals(op.Rol, "Cortador", StringComparison.OrdinalIgnoreCase);

                <div class="p-3 border rounded bg-white shadow-sm" style="border-color:#dadce0 !important;">
                    <!-- Cabecera del Operador y Avatar según Rol -->
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="position-relative">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                                     style="width:40px; height:40px; background:@(isCortador ? "#dc2626" : "#2563eb"); font-size:0.95rem;">
                                    @(op.NombreOperario.Length > 0 ? op.NombreOperario.Substring(0, 1).ToUpper() : "T")
                                </div>
                                <span class="position-absolute bottom-0 end-0 rounded-circle border border-white @(isOnline ? "pulse-online-halo" : "")"
                                      style="background:@(isOnline ? "#22c55e" : "#94a3b8"); width:12px; height:12px;"></span>
                            </div>
                            <div>
                                <div class="fw-bold text-dark text-truncate" style="max-width:190px; font-size:0.92rem;">
                                    @op.NombreOperario
                                </div>
                                <div class="d-flex align-items-center gap-1 mt-1">
                                    @if (isCortador)
                                    {
                                        <span class="role-badge-cortador">
                                            <i class="bi bi-slash-circle"></i> Cortador
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="role-badge-reconector">
                                            <i class="bi bi-droplet-fill"></i> Reconector
                                        </span>
                                    }

                                    <!-- Botón para alternar rol en 1 clic -->
                                    <button type="button" class="worker-role-switch-btn ms-1" 
                                            disabled="@cambiandoRolId == op.OperarioId"
                                            @onclick='() => CambiarRolAsync(op, isCortador ? "Reconector" : "Cortador")'
                                            title="Cambiar rol entre Cortador y Reconector">
                                        @if (cambiandoRolId == op.OperarioId)
                                        {
                                            <span class="spinner-border spinner-border-sm" style="width:8px; height:8px;" role="status"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-left-right me-1"></i>
                                            <span>@(isCortador ? "Pasar a Reconector" : "Pasar a Cortador")</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Estado En Línea / Batería -->
                        <div class="text-end">
                            @if (isOnline)
                            {
                                <span class="badge bg-success-subtle text-success mb-1 d-inline-flex align-items-center gap-1" style="font-size:0.7rem;">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="6" width="18" height="12" rx="2"></rect><line x1="23" y1="11" x2="23" y2="13"></line></svg>
                                    @bat% · @vel.ToString("F0") km/h
                                </span>
                            }
                            else if (op.UltimaActividad.HasValue)
                            {
                                <span class="badge bg-light text-muted" style="font-size:0.68rem;">
                                    Últ: @op.UltimaActividad.Value.ToLocalTime().ToString("dd/MM HH:mm")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted" style="font-size:0.68rem;">Sin conexión</span>
                            }
                            <div class="text-muted" style="font-size:0.68rem;">ID: @op.OperarioId</div>
                        </div>
                    </div>

                    <!-- Datos Telemáticos y Geográficos Completos -->
                    <div class="p-2 rounded bg-light border mb-2" style="font-size:0.72rem;">
                        <div class="row g-1">
                            <div class="col-6">
                                <span class="text-muted">Velocidad:</span> <strong>@vel.ToString("F1") km/h</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted">Rumbo:</span> <strong>@rumbo.ToString("F0")°</strong>
                            </div>
                            @if (lat.HasValue && lng.HasValue)
                            {
                                <div class="col-12 text-truncate">
                                    <span class="text-muted">GPS:</span> <code>@lat.Value.ToString("F5"), @lng.Value.ToString("F5")</code>
                                </div>
                            }
                            <div class="col-12">
                                <span class="text-muted">Posiciones registradas hoy:</span> <strong>@op.TotalPuntos</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de Acción Modular Directa según el Rol -->
                    <div class="d-flex flex-wrap gap-1 pt-1 border-top">
                        @if (isCortador)
                        {
                            <button type="button" class="btn btn-sm btn-danger flex-fill d-flex align-items-center justify-content-center gap-1 shadow-sm" style="font-size:0.75rem;"
                                    @onclick="() => OnAsignarCorte.InvokeAsync(op.OperarioId)" title="Asignar cortes a este trabajador">
                                <i class="bi bi-slash-circle"></i>
                                <span>Asignar Cortes</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-primary flex-fill d-flex align-items-center justify-content-center gap-1 shadow-sm" style="font-size:0.75rem;"
                                    @onclick="() => OnAsignarReconexion.InvokeAsync(op.OperarioId)" title="Asignar reconexiones a este trabajador">
                                <i class="bi bi-droplet-fill"></i>
                                <span>Asignar Reconexión</span>
                            </button>
                        }

                        @if (lat.HasValue && lng.HasValue)
                        {
                            <button type="button" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1" style="font-size:0.75rem;"
                                    @onclick="() => UbicarEnMapa(op, lat.Value, lng.Value, vel, rumbo, bat)" title="Centrar mapa en posición GPS">
                                <i class="bi bi-crosshair"></i>
                            </button>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" style="font-size:0.75rem;"
                                @onclick="() => OnVerHistorial.InvokeAsync(op.OperarioId)" title="Ver recorrido histórico en mapa">
                            <i class="bi bi-clock-history"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<string> OnAsignarCorte { get; set; }
    [Parameter] public EventCallback<string> OnAsignarReconexion { get; set; }
    [Parameter] public EventCallback<string> OnVerHistorial { get; set; }

    private bool isLoading = false;
    private string filtroTexto = string.Empty;
    private string filtroRol = "todos"; // "todos", "Cortador", "Reconector"
    private bool soloSoloEnLinea = false;
    private string? mensajeFeedback;
    private string? cambiandoRolId;

    private List<OperarioItemDto> operarios = new();
    private List<TrackingPosicionItemDto> operariosActivos = new();


    private int TotalCortadores => operarios.Count(o => string.Equals(o.Rol, "Cortador", StringComparison.OrdinalIgnoreCase));
    private int TotalReconectores => operarios.Count(o => string.Equals(o.Rol, "Reconector", StringComparison.OrdinalIgnoreCase));

    private int CortadoresActivos => operariosActivos.Count(o => string.Equals(o.Rol, "Cortador", StringComparison.OrdinalIgnoreCase) ||
                                                                 operarios.Any(x => x.OperarioId == o.OperarioId && string.Equals(x.Rol, "Cortador", StringComparison.OrdinalIgnoreCase)));
    private int ReconectoresActivos => operariosActivos.Count(o => string.Equals(o.Rol, "Reconector", StringComparison.OrdinalIgnoreCase) ||
                                                                   operarios.Any(x => x.OperarioId == o.OperarioId && string.Equals(x.Rol, "Reconector", StringComparison.OrdinalIgnoreCase)));

    private List<OperarioItemDto> OperariosFiltrados
    {
        get
        {
            var list = operarios.AsEnumerable();

            if (filtroRol == "Cortador")
                list = list.Where(o => string.Equals(o.Rol, "Cortador", StringComparison.OrdinalIgnoreCase));
            else if (filtroRol == "Reconector")
                list = list.Where(o => string.Equals(o.Rol, "Reconector", StringComparison.OrdinalIgnoreCase));

            if (soloSoloEnLinea)
            {
                list = list.Where(o => o.EnLinea || operariosActivos.Any(a => string.Equals(a.OperarioId, o.OperarioId, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                list = list.Where(o => o.NombreOperario.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)
                                    || o.Rol.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)
                                    || o.OperarioId.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase));
            }

            return list.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarOperarios();

    }

    public async Task CargarOperarios()
    {
        isLoading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<List<OperarioItemDto>>("/api/tracking/operarios");
            operarios = res ?? new();

            var activos = await Http.GetFromJsonAsync<List<TrackingPosicionItemDto>>("/api/tracking/activos");
            operariosActivos = activos ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar operarios: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CargarOperariosSilencioso()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<OperarioItemDto>>("/api/tracking/operarios");
            if (res != null) operarios = res;

            var activos = await Http.GetFromJsonAsync<List<TrackingPosicionItemDto>>("/api/tracking/activos");
            if (activos != null) operariosActivos = activos;

            StateHasChanged();
        }
        catch { }
    }

    private async Task CambiarRolAsync(OperarioItemDto op, string nuevoRol)
    {
        cambiandoRolId = op.OperarioId;
        StateHasChanged();
        try
        {
            var resp = await Http.PutAsJsonAsync($"/api/tracking/operarios/{op.OperarioId}/rol", new { Rol = nuevoRol });
            if (resp.IsSuccessStatusCode)
            {
                op.Rol = nuevoRol;
                mensajeFeedback = $"El trabajador {op.NombreOperario} ahora tiene rol de {nuevoRol}.";
                await CargarOperarios();
            }
            else
            {
                mensajeFeedback = "No se pudo actualizar el rol. Intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error al cambiar rol: {ex.Message}";
        }
        finally
        {
            cambiandoRolId = null;
            StateHasChanged();
        }
    }

    private async Task UbicarEnMapa(OperarioItemDto op, double lat, double lng, double vel, double rumbo, int bat)
    {
        var obj = new
        {
            operarioId = op.OperarioId,
            nombreOperario = op.NombreOperario,
            rol = op.Rol,
            latitud = lat,
            longitud = lng,
            velocidad = vel,
            rumbo = rumbo,
            bateria = bat
        };
        await JS.InvokeVoidAsync("arquis.updateOperarioMarker", obj);
        await JS.InvokeVoidAsync("arquis.centerOnCoords", lat, lng, 18);
    }



    public class OperarioItemDto
    {
        public string OperarioId { get; set; } = "";
        public string NombreOperario { get; set; } = "";
        public string Rol { get; set; } = "";
        public int TotalPuntos { get; set; }
        public DateTime? UltimaActividad { get; set; }
        public bool EnLinea { get; set; }
        public double? Latitud { get; set; }
        public double? Longitud { get; set; }
        public double Velocidad { get; set; }
        public double Rumbo { get; set; }
        public int Bateria { get; set; }
    }

    public class TrackingPosicionItemDto
    {
        public string OperarioId { get; set; } = "";
        public string NombreOperario { get; set; } = "";
        public string Rol { get; set; } = "";
        public double Latitud { get; set; }
        public double Longitud { get; set; }
        public double Rumbo { get; set; }
        public double Velocidad { get; set; }
        public int Bateria { get; set; }
        public DateTime Timestamp { get; set; }
    }
}
