@inject HttpClient Http
@inject IJSRuntime JS
@implements IDisposable

<div class="drawer-view-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h6 class="fw-bold mb-0 text-primary d-flex align-items-center gap-2">
                <i class="bi bi-droplet-fill"></i>
                <span>Gestión y Asignación de Reconexiones</span>
            </h6>
            <small class="text-muted">Restitución y habilitación del servicio de agua potable para <strong>Reconectores</strong></small>
        </div>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn @(vistaActual == "crear" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => vistaActual = "crear"'>
                Nuevo Ticket
            </button>
            <button type="button" class="btn @(vistaActual == "masiva" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => vistaActual = "masiva"'>
                <i class="bi bi-layers-fill me-1"></i>Asignación Masiva
            </button>
            <button type="button" class="btn @(vistaActual == "tickets" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => vistaActual = "tickets"'>
                Tickets Activos (@ticketsReconexion.Count)
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 small mb-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i>
            @mensajeExito
            <button type="button" class="btn-close py-2 px-3" @onclick="() => mensajeExito = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 small mb-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            @mensajeError
            <button type="button" class="btn-close py-2 px-3" @onclick="() => mensajeError = null"></button>
        </div>
    }

    @if (vistaActual == "crear")
    {
        <!-- PASO 1: SELECCIÓN TERRITORIAL DE PREDIOS Y CASAS CORTADAS -->
        <div class="card border-0 shadow-sm mb-3" style="background:#f8fafc; border:1px solid #e2e8f0 !important;">
            <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-bold small text-dark d-flex align-items-center gap-1">
                    <i class="bi bi-geo-alt-fill text-primary"></i>
                    <span>1. Filtrar Cuentas Cortadas / Habilitaciones Pendientes</span>
                </span>
                <span class="badge bg-secondary-subtle text-secondary" style="font-size:0.7rem;">Datos SIG Reales</span>
            </div>
            <div class="card-body p-3">
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted mb-1" style="font-size:0.72rem;">Unidad Vecinal (UV)</label>
                        <select class="form-select form-select-sm" @bind="uvSeleccionada" @bind:after="OnZonaCambiada">
                            <option value="">-- Todas las UV --</option>
                            @foreach (var uv in listaUvs)
                            {
                                <option value="@uv">UV @uv</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted mb-1" style="font-size:0.72rem;">Manzana (MZA)</label>
                        <select class="form-select form-select-sm" @bind="mzaSeleccionada" @bind:after="CargarEntidades">
                            <option value="">-- Todas las MZA --</option>
                            @foreach (var m in ManzanasFiltradas)
                            {
                                <option value="@m.MZA">MZA @m.MZA</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="input-group input-group-sm mb-2">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Buscar por titular, código fijo o lote..." 
                           @bind="filtroBusqueda" @bind:event="oninput" />
                    <button class="btn btn-outline-secondary" type="button" @onclick="CargarEntidades" title="Buscar en base de datos">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>

                <!-- Botones de Selección Rápida -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <small class="text-muted" style="font-size:0.72rem;">
                        Mostrando @entidadesDisponibles.Count cuentas cortadas
                    </small>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-outline-secondary py-0 px-2 small" style="font-size:0.68rem;" @onclick="() => SeleccionarPrimeros(10)">
                            Primeros 10
                        </button>
                        <button type="button" class="btn btn-outline-secondary py-0 px-2 small" style="font-size:0.68rem;" @onclick="() => SeleccionarPrimeros(25)">
                            Primeros 25
                        </button>
                        <button type="button" class="btn btn-link p-0 text-decoration-none small text-primary" style="font-size:0.72rem;" @onclick="SeleccionarTodasEntidades">
                            Todos
                        </button>
                        <span class="text-muted small">|</span>
                        <button type="button" class="btn btn-link p-0 text-decoration-none small text-danger" style="font-size:0.72rem;" @onclick="DeseleccionarTodasEntidades">
                            Limpiar
                        </button>
                    </div>
                </div>

                @if (isLoadingEntidades)
                {
                    <div class="text-center py-4 bg-white rounded border">
                        <div class="spinner-border spinner-border-sm text-primary mb-1" role="status"></div>
                        <div class="small text-muted">Consultando cuentas cortadas en la base de datos...</div>
                    </div>
                }
                else if (entidadesDisponibles.Count == 0)
                {
                    <div class="text-center py-4 bg-white rounded border text-muted small">
                        No se encontraron cuentas cortadas con los filtros seleccionados.
                    </div>
                }
                else
                {
                    <div class="border rounded bg-white p-1" style="max-height:200px; overflow-y:auto;">
                        @foreach (var ent in entidadesDisponibles)
                        {
                            var isSelected = idsSeleccionados.Contains(ent.IdCodigo);
                            <div class="p-2 border-bottom d-flex align-items-center gap-2 @(isSelected ? "bg-light" : "")" style="font-size:0.78rem;">
                                <input class="form-check-input mt-0" type="checkbox" checked="@isSelected" @onchange="() => ToggleEntidad(ent.IdCodigo)" />
                                <div class="flex-grow-1 text-truncate">
                                    <div class="fw-semibold text-dark text-truncate">
                                        @ent.CodigoSuministro · @ent.Titular
                                    </div>
                                    <div class="text-muted small" style="font-size:0.7rem;">
                                        @ent.Direccion
                                    </div>
                                </div>
                                <div class="text-end text-nowrap">
                                    <span class="badge bg-success-subtle text-success" style="font-size:0.68rem;">Pago Verificado</span>
                                    <button type="button" class="btn btn-sm btn-link p-0 ms-1 text-muted" @onclick="() => CentrarEnMapa(ent.Latitud, ent.Longitud)" title="Ver en mapa">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (idsSeleccionados.Count > 0)
                {
                    <div class="mt-2 p-2 rounded bg-primary-subtle text-primary-emphasis small d-flex justify-content-between align-items-center" style="font-size:0.75rem;">
                        <span><i class="bi bi-check2-circle me-1"></i><strong>@idsSeleccionados.Count</strong> casas listas para reconexión</span>
                        <span class="fw-bold text-success"><i class="bi bi-patch-check-fill me-1"></i>Sin deudas pendientes</span>
                    </div>
                }
            </div>
        </div>

        <!-- PASO 2: ASIGNACIÓN A RECONECTOR -->
        <div class="card border-0 shadow-sm mb-3" style="border:1px solid #e2e8f0 !important;">
            <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-bold small text-dark d-flex align-items-center gap-1">
                    <i class="bi bi-person-badge-fill text-primary"></i>
                    <span>2. Asignar Reconector Responsable</span>
                </span>
                <span class="role-badge-reconector">Rol: Reconector</span>
            </div>
            <div class="card-body p-3">
                <div class="mb-2">
                    <label class="form-label small fw-semibold text-muted mb-1" style="font-size:0.72rem;">Reconector de Campo Asignado</label>
                    <select class="form-select form-select-sm" @bind="operarioSeleccionado">
                        <option value="">-- Seleccione un Reconector --</option>
                        @foreach (var op in SoloReconectores)
                        {
                            <option value="@op.OperarioId">
                                @op.NombreOperario @(op.EnLinea ? "· EN LÍNEA" : "· Desconectado")
                            </option>
                        }
                        @if (OtrosOperarios.Any())
                        {
                            <optgroup label="Otros Trabajadores de Campo">
                                @foreach (var op in OtrosOperarios)
                                {
                                    <option value="@op.OperarioId">@op.NombreOperario (@op.Rol)</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-muted mb-1" style="font-size:0.72rem;">Prioridad del Ticket</label>
                        <select class="form-select form-select-sm" @bind="ticketPrioridad">
                            <option value="Normal">Normal</option>
                            <option value="Alta">Alta</option>
                            <option value="Urgente">Urgente</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-muted mb-1" style="font-size:0.72rem;">Título de la Orden</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Ej. Habilitación Servicio UV 4" @bind="ticketTitulo" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted mb-1" style="font-size:0.72rem;">Instrucciones Técnicas de Reconexión</label>
                    <textarea class="form-control form-control-sm" rows="2" placeholder="Retirar precinto de seguridad, aperturar válvula de paso, verificar presión..." @bind="ticketObservaciones"></textarea>
                </div>

                <!-- SELECCIÓN DEL PUNTO DE PARTIDA INICIAL (RF-WEB-04) -->
                <div class="mb-3 p-2 rounded bg-light border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-dark mb-0" style="font-size:0.72rem;">
                            <i class="bi bi-geo-alt-fill text-primary me-1"></i>Punto de Partida Cuadrilla (RF-WEB-04)
                        </label>
                        <span class="badge @(isCustomPartida ? "bg-primary" : "bg-secondary")" style="font-size:0.65rem;">
                            @(isCustomPartida ? "Punto en Mapa" : "Base Central")
                        </span>
                    </div>
                    <div class="small text-muted mb-2 text-truncate" style="font-size:0.7rem;">
                        @partidaNombre
                    </div>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm @(isPickingPartidaOnMap ? "btn-warning" : "btn-outline-primary") flex-fill py-1" style="font-size:0.72rem;"
                                @onclick="ToggleMapDeparturePicker">
                            <i class="bi bi-pin-map-fill me-1"></i>
                            @(isPickingPartidaOnMap ? "Haga clic en el mapa..." : "Fijar con 1 clic en mapa")
                        </button>
                        @if (isCustomPartida)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:0.72rem;" @onclick="RestablecerBaseOperativa" title="Restablecer a Base Operativa">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- PREVISUALIZACIÓN DE RUTA ÓPTIMA CON DIJKSTRA (RF-WEB-05) -->
                @if (idsSeleccionados.Count > 0)
                {
                    <div class="mb-3 p-2 rounded border bg-primary-subtle bg-opacity-10">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-primary" style="font-size:0.75rem;">
                                <i class="bi bi-diagram-3-fill me-1"></i>Ruta Topológica Dijkstra (RF-WEB-05)
                            </span>
                            <button type="button" class="btn btn-sm btn-primary py-0 px-2" style="font-size:0.7rem;"
                                    disabled="@isOptimizingDijkstra"
                                    @onclick="OptimizarRutaDijkstraPreview">
                                <i class="bi bi-lightning-charge-fill me-1"></i>
                                @(isOptimizingDijkstra ? "Calculando..." : "Calcular con Dijkstra")
                            </button>
                        </div>
                        @if (resultadoDijkstra != null)
                        {
                            <div class="small text-dark" style="font-size:0.72rem;">
                                <div><i class="bi bi-signpost-split text-secondary me-1"></i>Distancia total: <strong>@resultadoDijkstra.DistanciaTotalKm km</strong> (@resultadoDijkstra.DistanciaTotalMetros m)</div>
                                <div><i class="bi bi-clock-history text-secondary me-1"></i>Tiempo estimado: <strong>~@resultadoDijkstra.TiempoEstimadoMinutos min</strong></div>
                                <div class="text-success mt-1"><i class="bi bi-check-circle-fill me-1"></i>Ruta sobre ejes viales y paradas 1, 2... @idsSeleccionados.Count ordenadas.</div>
                            </div>
                        }
                        else
                        {
                            <small class="text-muted d-block" style="font-size:0.68rem;">
                                Ordena las reconexiones secuencialmente sobre la red de calles evitando cruzar manzanas catastrales.
                            </small>
                        }
                    </div>
                }

                <button type="button" class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm"
                        disabled="@(idsSeleccionados.Count == 0 || string.IsNullOrEmpty(operarioSeleccionado) || isSubmitting)"
                        @onclick="CrearTicket">
                    <i class="bi bi-file-earmark-plus"></i>
                    <span>@(isSubmitting ? "Generando ticket..." : $"Despachar Orden de Reconexión ({idsSeleccionados.Count} puntos)")</span>
                </button>
            </div>
        </div>
    }
    else if (vistaActual == "masiva")
    {
        <!-- VISTA DE ASIGNACIÓN MASIVA A CUADRILLA DE RECONECTORES -->
        <div class="card border-0 shadow-sm mb-3" style="border:1px solid #e2e8f0 !important;">
            <div class="card-header bg-white py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                <span class="fw-bold small text-dark d-flex align-items-center gap-1">
                    <i class="bi bi-layers-fill text-primary"></i>
                    <span>Despacho Masivo a Cuadrilla de Reconectores</span>
                </span>
                <span class="badge bg-primary-subtle text-primary" style="font-size:0.7rem;">Distribución Equitativa</span>
            </div>
            <div class="card-body p-3">
                <p class="small text-muted mb-3" style="font-size:0.75rem;">
                    Esta herramienta selecciona cuentas cortadas regularizadas y las divide equitativamente entre los <strong>Reconectores</strong> seleccionados.
                </p>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted mb-1" style="font-size:0.72rem;">Cantidad de Reconexiones a Habilitar</label>
                    <div class="d-flex gap-2">
                        @foreach (var cant in new[] { 10, 20, 40, 80 })
                        {
                            <button type="button" class="btn btn-sm @(cantidadMasiva == cant ? "btn-primary" : "btn-outline-secondary") flex-fill"
                                    @onclick="() => cantidadMasiva = cant">
                                @cant Reconexiones
                            </button>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted mb-1" style="font-size:0.72rem;">Reconectores Participantes</label>
                    <div class="border rounded bg-white p-2">
                        @if (SoloReconectores.Count == 0)
                        {
                            <div class="text-muted small py-2 text-center">No hay reconectores registrados.</div>
                        }
                        else
                        {
                            @foreach (var r in SoloReconectores)
                            {
                                var sel = reconectoresMasivosSeleccionados.Contains(r.OperarioId);
                                <div class="form-check form-check-inline me-3 mb-1">
                                    <input class="form-check-input" type="checkbox" checked="@sel" @onchange="() => ToggleReconectorMasivo(r.OperarioId)" id="chk_rec_@r.OperarioId" />
                                    <label class="form-check-label small" for="chk_rec_@r.OperarioId">
                                        @r.NombreOperario @(r.EnLinea ? "· (En línea)" : "")
                                    </label>
                                </div>
                            }
                        }
                    </div>
                </div>

                @if (reconectoresMasivosSeleccionados.Count > 0)
                {
                    var cuentasPorReconector = (int)Math.Ceiling((double)cantidadMasiva / reconectoresMasivosSeleccionados.Count);
                    <div class="p-2 rounded bg-light border mb-3 small d-flex justify-content-between align-items-center">
                        <span class="text-muted">Cálculo de distribución:</span>
                        <strong class="text-primary">~@cuentasPorReconector habilitaciones por cada reconector</strong>
                    </div>
                }

                <!-- PUNTO DE SALIDA DE CUADRILLAS MASIVAS (RF-WEB-04) -->
                <div class="mb-3 p-2 rounded bg-light border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-dark mb-0" style="font-size:0.72rem;">
                            <i class="bi bi-geo-alt-fill text-primary me-1"></i>Punto de Salida de Cuadrillas (RF-WEB-04)
                        </label>
                        <span class="badge @(isCustomPartida ? "bg-primary" : "bg-secondary")" style="font-size:0.65rem;">
                            @(isCustomPartida ? "Punto en Mapa" : "Base Central")
                        </span>
                    </div>
                    <div class="small text-muted mb-2 text-truncate" style="font-size:0.7rem;">
                        @partidaNombre
                    </div>
                    <button type="button" class="btn btn-sm @(isPickingPartidaOnMap ? "btn-warning" : "btn-outline-primary") w-100 py-1" style="font-size:0.72rem;"
                            @onclick="ToggleMapDeparturePicker">
                        <i class="bi bi-pin-map-fill me-1"></i>
                        @(isPickingPartidaOnMap ? "Haga clic en el mapa..." : "Fijar punto de salida en mapa con 1 clic")
                    </button>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted mb-1" style="font-size:0.72rem;">Título del Operativo Masivo</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Ej. Operativo Masivo de Restitución de Agua" @bind="tituloMasivo" />
                </div>

                <button type="button" class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm"
                        disabled="@(reconectoresMasivosSeleccionados.Count == 0 || isSubmitting)"
                        @onclick="EjecutarAsignacionMasiva">
                    <i class="bi bi-send-check"></i>
                    <span>@(isSubmitting ? "Distribuyendo reconexiones..." : $"Despachar {cantidadMasiva} Reconexiones entre {reconectoresMasivosSeleccionados.Count} Reconectores")</span>
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- LISTA DE TICKETS Y ÓRDENES DE RECONEXIÓN ACTIVAS -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <small class="text-muted fw-semibold">Historial de Órdenes de Reconexión</small>
            <button type="button" class="btn btn-sm btn-outline-secondary py-0" @onclick="CargarTickets" title="Refrescar">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>

        @if (isLoadingTickets)
        {
            <div class="text-center py-4 bg-white rounded border">
                <div class="spinner-border spinner-border-sm text-primary mb-1" role="status"></div>
                <div class="small text-muted">Cargando órdenes de reconexión...</div>
            </div>
        }
        else if (ticketsReconexion.Count == 0)
        {
            <div class="text-center py-5 bg-white rounded border text-muted small">
                <i class="bi bi-inbox fs-2 mb-2 d-block"></i>
                No hay órdenes de reconexión registradas actualmente.
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var tk in ticketsReconexion)
                {
                    var pct = tk.TotalPuntos > 0 ? (int)Math.Round((double)tk.PuntosCompletados / tk.TotalPuntos * 100) : 0;
                    <div class="p-3 border rounded bg-white shadow-sm" style="border-color:#dadce0 !important;">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div>
                                <span class="badge bg-primary-subtle text-primary fw-bold me-1">@tk.Codigo</span>
                                <span class="badge @(tk.Estado == "Completada" ? "bg-success" : (tk.Estado == "EnProgreso" ? "bg-primary" : "bg-warning text-dark"))" style="font-size:0.68rem;">
                                    @tk.Estado
                                </span>
                            </div>
                            <small class="text-muted" style="font-size:0.7rem;">@tk.FechaCreacion.ToLocalTime().ToString("dd/MM HH:mm")</small>
                        </div>

                        <div class="fw-semibold text-dark mb-1" style="font-size:0.85rem;">@tk.Titulo</div>
                        
                        <div class="d-flex align-items-center gap-2 mb-2" style="font-size:0.75rem;">
                            <span class="text-muted">Reconector: <strong class="text-dark">@tk.OperarioAsignado</strong></span>
                            <span class="text-muted">·</span>
                            <span class="text-muted">Progreso: <strong>@tk.PuntosCompletados / @tk.TotalPuntos (@pct%)</strong></span>
                        </div>

                        <!-- Barra de Progreso de Ejecución -->
                        <div class="assignment-progress-bar mb-2">
                            <div class="assignment-progress-fill bg-primary" style="width:@pct%;"></div>
                        </div>

                        @if (!string.IsNullOrEmpty(tk.Observaciones))
                        {
                            <div class="p-2 rounded bg-light text-muted small mb-2" style="font-size:0.72rem;">
                                @tk.Observaciones
                            </div>
                        }

                        <div class="d-flex gap-1 pt-2 border-top">
                            <button type="button" class="btn btn-sm btn-outline-primary flex-fill d-flex align-items-center justify-content-center gap-1" style="font-size:0.75rem;"
                                    @onclick="() => TrazarRutaEnMapa(tk)">
                                <i class="bi bi-map"></i>
                                <span>Ver Puntos en Mapa</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string? PreselectedOperarioId { get; set; }
    [Parameter] public EventCallback<object> OnVerRutaEnMapa { get; set; }

    private string vistaActual = "crear";
    private bool isLoadingEntidades = false;
    private bool isLoadingTickets = false;
    private bool isSubmitting = false;

    private string? mensajeExito;
    private string? mensajeError;

    // Filtros de zona
    private string uvSeleccionada = "";
    private string mzaSeleccionada = "";
    private string filtroBusqueda = "";

    // Datos territoriales
    private List<string> listaUvs = new();
    private List<ManzanaDto> listaManzanas = new();
    private List<EntidadDisponibleDto> entidadesDisponibles = new();
    private HashSet<int> idsSeleccionados = new();

    // Operadores
    private List<OperarioItemDto> operarios = new();

    // Creación de ticket
    private string operarioSeleccionado = "";
    private string ticketPrioridad = "Normal";
    private string ticketTitulo = "";
    private string ticketObservaciones = "";

    // Asignación Masiva
    private int cantidadMasiva = 20;
    private string tituloMasivo = "Operativo General de Restitución de Servicio";
    private HashSet<string> reconectoresMasivosSeleccionados = new();

    // Historial de tickets
    private List<TicketRutaDto> ticketsReconexion = new();

    // Punto de Partida (RF-WEB-04) y Optimización Dijkstra (RF-WEB-05)
    private DotNetObjectReference<AsignarReconexionesView>? dotNetRef;
    private double partidaLat = 0;
    private double partidaLng = 0;
    private string partidaNombre = "Primera parada seleccionada";
    private bool isCustomPartida = false;
    private bool isPickingPartidaOnMap = false;
    private bool isOptimizingDijkstra = false;
    private ResultadoDijkstraDto? resultadoDijkstra;

    [JSInvokable]
    public void OnDeparturePointPicked(double lat, double lng)
    {
        partidaLat = lat;
        partidaLng = lng;
        partidaNombre = $"Punto fijado en mapa ({lat:F5}, {lng:F5})";
        isCustomPartida = true;
        isPickingPartidaOnMap = false;
        StateHasChanged();
    }

    private async Task ToggleMapDeparturePicker()
    {
        if (isPickingPartidaOnMap)
        {
            isPickingPartidaOnMap = false;
            await JS.InvokeVoidAsync("arquis.cancelDeparturePointSelection");
        }
        else
        {
            isPickingPartidaOnMap = true;
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("arquis.enableDeparturePointSelection", dotNetRef);
        }
    }

    private async Task RestablecerBaseOperativa()
    {
        partidaLat = 0;
        partidaLng = 0;
        partidaNombre = "Primera parada seleccionada";
        isCustomPartida = false;
        isPickingPartidaOnMap = false;
        await JS.InvokeVoidAsync("arquis.cancelDeparturePointSelection");
        await JS.InvokeVoidAsync("arquis.clearOptimizedRoute");
        resultadoDijkstra = null;
    }

    private async Task OptimizarRutaDijkstraPreview()
    {
        if (idsSeleccionados.Count == 0) return;
        isOptimizingDijkstra = true;
        try
        {
            var puntos = entidadesDisponibles
                .Where(e => idsSeleccionados.Contains(e.IdCodigo))
                .Select(e => new
                {
                    IdCodigoFijo = e.IdCodigo,
                    IdLote = 0,
                    CodigoSuministro = e.CodigoSuministro,
                    Titular = e.Titular,
                    Direccion = e.Direccion,
                    Latitud = e.Latitud,
                    Longitud = e.Longitud,
                    MontoDeuda = 0.00m
                }).ToList();

            var req = new
            {
                Partida = new
                {
                    Latitud = partidaLat,
                    Longitud = partidaLng,
                    Nombre = partidaNombre
                },
                Puntos = puntos
            };

            var res = await Http.PostAsJsonAsync("/api/rutas-trabajo/optimizar-preview", req);
            if (res.IsSuccessStatusCode)
            {
                resultadoDijkstra = await res.Content.ReadFromJsonAsync<ResultadoDijkstraDto>();
                if (resultadoDijkstra != null)
                {
                    await JS.InvokeVoidAsync("arquis.renderOptimizedDijkstraRoute", resultadoDijkstra.GeometriaGeoJson, resultadoDijkstra.PuntosOrdenados);
                }
                mensajeError = null;
            }
            else
            {
                resultadoDijkstra = null;
                await JS.InvokeVoidAsync("arquis.clearOptimizedRoute");
                var error = await res.Content.ReadFromJsonAsync<ErrorDto>();
                mensajeError = error?.Error ?? "No se pudo calcular una ruta por las vías disponibles.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo calcular la ruta. Verifique la conexión y los puntos seleccionados.";
            Console.WriteLine($"Error optimizando reconexiones con Dijkstra: {ex.Message}");
        }
        finally
        {
            isOptimizingDijkstra = false;
        }
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    private List<OperarioItemDto> SoloReconectores => operarios.Where(o => string.Equals(o.Rol, "Reconector", StringComparison.OrdinalIgnoreCase)).ToList();
    private List<OperarioItemDto> OtrosOperarios => operarios.Where(o => !string.Equals(o.Rol, "Reconector", StringComparison.OrdinalIgnoreCase)).ToList();

    private IEnumerable<ManzanaDto> ManzanasFiltradas => string.IsNullOrEmpty(uvSeleccionada)
        ? listaManzanas
        : listaManzanas.Where(m => m.UV == uvSeleccionada);

    protected override async Task OnInitializedAsync()
    {
        await CargarOperarios();
        await CargarZonas();
        await CargarEntidades();
        await CargarTickets();

        if (!string.IsNullOrEmpty(PreselectedOperarioId))
        {
            operarioSeleccionado = PreselectedOperarioId;
        }
    }

    private async Task CargarZonas()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<ZonasResponseDto>("/api/rutas-trabajo/zonas");
            if (res != null)
            {
                listaUvs = res.Uvs ?? new();
                listaManzanas = res.Manzanas ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar zonas: {ex.Message}");
        }
    }

    private async Task CargarOperarios()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<List<OperarioItemDto>>("/api/tracking/operarios");
            operarios = res ?? new();
            
            var reconectores = SoloReconectores;
            if (string.IsNullOrEmpty(operarioSeleccionado) && reconectores.Count > 0)
            {
                operarioSeleccionado = reconectores.First().OperarioId;
            }
            else if (string.IsNullOrEmpty(operarioSeleccionado) && operarios.Count > 0)
            {
                operarioSeleccionado = operarios.First().OperarioId;
            }

            reconectoresMasivosSeleccionados = reconectores.Select(r => r.OperarioId).ToHashSet();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar operarios: {ex.Message}");
        }
    }

    private async Task CargarEntidades()
    {
        isLoadingEntidades = true;
        try
        {
            var url = $"/api/rutas-trabajo/entidades-disponibles?tipo=Reconexion&uv={Uri.EscapeDataString(uvSeleccionada)}&mza={Uri.EscapeDataString(mzaSeleccionada)}&busqueda={Uri.EscapeDataString(filtroBusqueda)}&limite=150";
            var res = await Http.GetFromJsonAsync<List<EntidadDisponibleDto>>(url);
            entidadesDisponibles = res ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar cuentas de reconexión: {ex.Message}");
        }
        finally
        {
            isLoadingEntidades = false;
        }
    }

    private async Task OnZonaCambiada()
    {
        mzaSeleccionada = "";
        await CargarEntidades();
    }

    private void ToggleEntidad(int id)
    {
        if (idsSeleccionados.Contains(id)) idsSeleccionados.Remove(id);
        else idsSeleccionados.Add(id);
    }

    private void ToggleReconectorMasivo(string opId)
    {
        if (reconectoresMasivosSeleccionados.Contains(opId))
            reconectoresMasivosSeleccionados.Remove(opId);
        else
            reconectoresMasivosSeleccionados.Add(opId);
    }

    private void SeleccionarTodasEntidades()
    {
        idsSeleccionados = entidadesDisponibles.Select(x => x.IdCodigo).ToHashSet();
    }

    private void SeleccionarPrimeros(int cantidad)
    {
        idsSeleccionados = entidadesDisponibles.Take(cantidad).Select(x => x.IdCodigo).ToHashSet();
    }

    private void DeseleccionarTodasEntidades()
    {
        idsSeleccionados.Clear();
    }

    private async Task CentrarEnMapa(double lat, double lng)
    {
        await JS.InvokeVoidAsync("arquis.centerOnCoords", lat, lng, 18);
    }

    private async Task CrearTicket()
    {
        if (idsSeleccionados.Count == 0)
        {
            mensajeError = "Seleccione al menos una casa o predio para reconectar.";
            return;
        }

        if (string.IsNullOrEmpty(operarioSeleccionado))
        {
            mensajeError = "Seleccione el reconector técnico responsable.";
            return;
        }

        isSubmitting = true;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            var dto = new
            {
                Titulo = string.IsNullOrWhiteSpace(ticketTitulo) ? $"Orden de Reconexión - {DateTime.UtcNow:dd/MM/yyyy}" : ticketTitulo,
                Tipo = "Reconexion",
                Prioridad = ticketPrioridad,
                OperarioAsignado = operarioSeleccionado,
                Observaciones = ticketObservaciones,
                PartidaLatitud = isCustomPartida ? (double?)partidaLat : null,
                PartidaLongitud = isCustomPartida ? (double?)partidaLng : null,
                PartidaNombre = partidaNombre,
                IdsCodigosFijos = idsSeleccionados.ToList()
            };

            var res = await Http.PostAsJsonAsync("/api/rutas-trabajo/crear-ticket", dto);
            if (res.IsSuccessStatusCode)
            {
                var data = await res.Content.ReadFromJsonAsync<CrearTicketRespuestaDto>();
                mensajeExito = data?.Mensaje ?? "Orden de reconexión generada y despachada exitosamente.";
                idsSeleccionados.Clear();
                ticketTitulo = "";
                ticketObservaciones = "";
                await CargarTickets();
                await CargarEntidades();
                vistaActual = "tickets";
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ErrorDto>();
                mensajeError = err?.Error ?? "Ocurrió un error al crear la orden de reconexión.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de comunicación: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task EjecutarAsignacionMasiva()
    {
        if (reconectoresMasivosSeleccionados.Count == 0)
        {
            mensajeError = "Debe seleccionar al menos un reconector para el despacho masivo.";
            return;
        }

        isSubmitting = true;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            var dto = new
            {
                TituloGeneral = string.IsNullOrWhiteSpace(tituloMasivo) ? "Operativo Masivo de Restitución de Agua" : tituloMasivo,
                Tipo = "Reconexion",
                Prioridad = "Alta",
                OperariosAsignados = reconectoresMasivosSeleccionados.ToList(),
                CantidadCuentas = cantidadMasiva,
                PartidaLatitud = isCustomPartida ? (double?)partidaLat : null,
                PartidaLongitud = isCustomPartida ? (double?)partidaLng : null,
                PartidaNombre = partidaNombre,
                Observaciones = "Habilitación y reconexión inmediata de servicio de agua potable con pago verificado. Despacho masivo optimizado con Dijkstra sobre red vial."
            };

            var res = await Http.PostAsJsonAsync("/api/rutas-trabajo/asignacion-masiva", dto);
            if (res.IsSuccessStatusCode)
            {
                var data = await res.Content.ReadFromJsonAsync<CrearTicketRespuestaDto>();
                mensajeExito = data?.Mensaje ?? $"Se asignaron {cantidadMasiva} reconexiones distribuidas entre los reconectores seleccionados.";
                await CargarTickets();
                vistaActual = "tickets";
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ErrorDto>();
                mensajeError = err?.Error ?? "Ocurrió un error al procesar el despacho masivo.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CargarTickets()
    {
        isLoadingTickets = true;
        try
        {
            var res = await Http.GetFromJsonAsync<List<TicketRutaDto>>("/api/rutas-trabajo?estado=&operario=");
            if (res != null)
            {
                ticketsReconexion = res.Where(r => r.Tipo.Equals("Reconexion", StringComparison.OrdinalIgnoreCase)).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar tickets: {ex.Message}");
        }
        finally
        {
            isLoadingTickets = false;
        }
    }

    private async Task TrazarRutaEnMapa(TicketRutaDto tk)
    {
        if (tk.Puntos != null && tk.Puntos.Count > 0)
        {
            await JS.InvokeVoidAsync("arquis.renderRutaTrabajo", tk);
            var primerPunto = tk.Puntos.First();
            await JS.InvokeVoidAsync("arquis.centerOnCoords", primerPunto.Latitud, primerPunto.Longitud, 16);
            await OnVerRutaEnMapa.InvokeAsync(tk);
        }
    }

