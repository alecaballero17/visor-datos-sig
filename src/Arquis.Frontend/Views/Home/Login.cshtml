@{ ViewData["Title"]="Iniciar sesión"; }
<div class="login-shell" data-api="@ViewBag.BackendBaseUrl">
  <div class="card shadow-sm login-card">
    <div class="card-body p-4 p-md-5">
      <div class="brand-mark mb-3">A</div>
      <h1 class="h3 mb-1">Arquis</h1>
      <p class="text-secondary mb-4">Administración del visor de datos geográficos</p>
      <form id="loginForm" novalidate>
        <div class="mb-3">
          <label for="usuario" class="form-label">Usuario o email</label>
          <input id="usuario" class="form-control" autocomplete="username" maxlength="254" required />
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Contraseña</label>
          <input id="password" type="password" class="form-control" autocomplete="current-password" required />
        </div>
        <div id="loginError" class="alert alert-danger @(ViewBag.LoginMessage is null ? "d-none" : "")" role="alert">@ViewBag.LoginMessage</div>
        <button class="btn btn-primary w-100" type="submit">Ingresar</button>
      </form>
      <p class="small text-secondary mt-3 mb-0">Los empleados operativos ingresan desde la aplicación móvil.</p>
    </div>
  </div>
</div>
@section Scripts { <script src="~/js/login.js" asp-append-version="true"></script> }
