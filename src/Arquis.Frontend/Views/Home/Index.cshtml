@{ ViewData["Title"]="Visor SIG"; }
<div id="app" data-api="@ViewBag.BackendBaseUrl" class="app-shell">
  <header class="app-header">
    <button id="toggleSidebar" class="btn btn-sm btn-outline-light d-md-none" aria-label="Abrir panel">☰</button>
    <div><strong>Arquis</strong><span class="d-none d-sm-inline"> · VisorDatosSIG</span></div>
    <div class="ms-auto d-flex align-items-center gap-2"><span id="userName" class="small"></span><button id="logoutBtn" class="btn btn-sm btn-light">Salir</button></div>
  </header>
  <div class="app-body">
    <aside id="sidebar" class="sidebar">
      <div class="p-3 border-bottom">
        <label for="searchText" class="form-label fw-semibold">Buscar</label>
        <div class="input-group"><input id="searchText" class="form-control" placeholder="Código, manzana, lote o vía" /><button id="searchBtn" class="btn btn-primary">Buscar</button></div>
        <button id="clearBtn" class="btn btn-sm btn-link px-0 mt-1">Limpiar resultados</button>
      </div>
      <div class="p-3 border-bottom">
        <div class="fw-semibold mb-2">Capas</div><div id="layerControl"></div>
      </div>
      <div class="p-3 border-bottom">
        <fieldset><legend class="h6">Disponibilidad de agua</legend>
          <div class="form-check"><input class="form-check-input" type="checkbox" id="showWithWater" checked><label class="form-check-label" for="showWithWater">Con agua</label></div>
          <div class="form-check"><input class="form-check-input" type="checkbox" id="showWithoutWater" checked><label class="form-check-label" for="showWithoutWater">Sin agua</label></div>
        </fieldset>
      </div>
      <div class="p-3 border-bottom">
        <div class="fw-semibold mb-2">Leyenda</div><div id="legend"></div>
      </div>
      <div class="p-3 results-panel">
        <div class="d-flex justify-content-between align-items-center"><span class="fw-semibold">Resultados</span><span id="resultCount" class="badge text-bg-secondary">0</span></div>
        <div id="resultStatus" class="small text-secondary py-2">Sin consulta activa.</div>
        <div id="results" class="list-group list-group-flush"></div>
      </div>
    </aside>
    <main class="map-wrap">
      <div id="map"></div>
      <div id="loading" class="map-loading d-none">Cargando capas…</div>
      <div id="coords" class="coords">Lon: - · Lat: -</div>
      <div id="detailPanel" class="detail-panel d-none"><button id="detailClose" class="btn-close float-end"></button><h2 class="h6">Entidad seleccionada</h2><div id="detailContent"></div></div>
    </main>
  </div>
</div>
@section Scripts { <script src="~/js/map.js" asp-append-version="true"></script> }
