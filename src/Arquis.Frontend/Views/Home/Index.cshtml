@{ ViewData["Title"]="Visor SIG"; }
<div id="app" data-api="@ViewBag.BackendBaseUrl" class="app-shell">
  <header class="app-header">
    <button id="toggleSidebar" class="btn btn-sm btn-outline-light d-md-none" aria-label="Abrir panel">☰</button>
    <div><strong>Arquis</strong><span class="d-none d-sm-inline"> · VisorDatosSIG</span></div>
    <div class="ms-auto d-flex align-items-center gap-2"><span id="userName" class="small"></span><button id="logoutBtn" class="btn btn-sm btn-light">Salir</button></div>
  </header>
  <div class="app-body">
    <aside id="sidebar" class="sidebar">
      <div class="p-3 border-bottom">
        <label for="searchText" class="form-label fw-semibold">Buscar</label>
        <div class="input-group"><input id="searchText" class="form-control" placeholder="Código, manzana, lote o vía" /><button id="searchBtn" class="btn btn-primary">Buscar</button></div>
        <button id="clearBtn" class="btn btn-sm btn-link px-0 mt-1">Limpiar resultados</button>
      </div>
      <div class="p-3 border-bottom">
        <div class="fw-semibold mb-2">Capas</div><div id="layerControl"></div>
      </div>
      <div class="p-3 border-bottom">
        <fieldset><legend class="h6">Disponibilidad de agua</legend>
          <div class="form-check"><input class="form-check-input" type="checkbox" id="showWithWater" checked><label class="form-check-label" for="showWithWater">Con agua</label></div>
          <div class="form-check"><input class="form-check-input" type="checkbox" id="showWithoutWater" checked><label class="form-check-label" for="showWithoutWater">Sin agua</label></div>
        </fieldset>
      </div>
      <div class="p-3 border-bottom">
        <div class="fw-semibold mb-2">Leyenda</div><div id="legend"></div>
      </div>
      <section id="assignmentPanel" class="p-3 border-bottom" aria-labelledby="assignmentHeading">
        <h2 id="assignmentHeading" class="h6 fw-semibold">Asignar trabajo</h2>
        <label for="assignmentType" class="form-label small mb-1">Tipo de trabajo</label>
        <select id="assignmentType" class="form-select form-select-sm mb-2">
          <option value="Corte">Corte</option>
          <option value="Reconexion">Reconexión</option>
        </select>
        <label for="assignmentEmployee" class="form-label small mb-1">Empleado</label>
        <select id="assignmentEmployee" class="form-select form-select-sm mb-2" disabled>
          <option value="">Cargando empleados…</option>
        </select>
        <div id="assignmentTarget" class="small text-secondary border rounded p-2 mb-2">Seleccione un código fijo en el mapa o en los resultados de búsqueda.</div>
        <button id="createAssignmentBtn" type="button" class="btn btn-sm btn-primary w-100" disabled>Asignar el punto seleccionado</button>
        <div id="assignmentMessage" class="small mt-2" role="status" aria-live="polite"></div>

        <details class="mt-3">
          <summary class="small fw-semibold">Crear usuario operativo</summary>
          <form id="employeeForm" class="pt-2">
            <label for="employeeName" class="form-label small mb-1">Nombre</label>
            <input id="employeeName" class="form-control form-control-sm mb-2" maxlength="120" required>
            <label for="employeeLogin" class="form-label small mb-1">Usuario de acceso</label>
            <input id="employeeLogin" class="form-control form-control-sm mb-2" maxlength="50" autocomplete="off" required>
            <label for="employeePassword" class="form-label small mb-1">Contraseña inicial</label>
            <input id="employeePassword" type="password" class="form-control form-control-sm mb-2" minlength="8" maxlength="128" autocomplete="new-password" required>
            <label for="employeeRole" class="form-label small mb-1">Rol</label>
            <select id="employeeRole" class="form-select form-select-sm mb-2">
              <option value="Cortador">Cortador</option>
              <option value="Conector">Conector</option>
            </select>
            <button class="btn btn-sm btn-outline-primary w-100" type="submit">Crear empleado</button>
            <div id="employeeMessage" class="small mt-2" role="status" aria-live="polite"></div>
          </form>
        </details>

        <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
          <span class="small fw-semibold">Asignaciones recientes</span>
          <button id="refreshAssignmentsBtn" class="btn btn-sm btn-outline-secondary" type="button">Actualizar</button>
        </div>
        <div id="assignmentList" class="small text-secondary" aria-live="polite">Cargando…</div>
      </section>
      <div class="p-3 results-panel">
        <div class="d-flex justify-content-between align-items-center"><span class="fw-semibold">Resultados</span><span id="resultCount" class="badge text-bg-secondary">0</span></div>
        <div id="resultStatus" class="small text-secondary py-2">Sin consulta activa.</div>
        <div id="results" class="list-group list-group-flush"></div>
      </div>
    </aside>
    <main class="map-wrap">
      <div id="map"></div>
      <div id="loading" class="map-loading d-none">Cargando capas…</div>
      <div id="coords" class="coords">Lon: - · Lat: -</div>
      <div id="detailPanel" class="detail-panel d-none"><button id="detailClose" class="btn-close float-end"></button><h2 class="h6">Entidad seleccionada</h2><div id="detailContent"></div></div>
    </main>
  </div>
</div>
@section Scripts { <script src="~/js/map.js" asp-append-version="true"></script> }
