@page "/"
@inject NavigationManager Navigation

<PageTitle>Arquis Visor - Inicio</PageTitle>

<div class="landing-page min-vh-100 d-flex flex-column bg-light">
    <!-- Navbar Minimalista -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="#">
                <div class="brand-mark-small">A</div>
                Arquis<span class="text-primary fw-light">Visor</span>
            </a>
            <div class="d-flex gap-3">
                <a href="/login" class="btn text-dark fw-semibold text-decoration-none">Iniciar Sesión</a>
                <a href="/signup" class="btn btn-primary px-4 rounded-pill">Registrarse</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section con Glassmorphism y Gradiente -->
    <main class="flex-grow-1 d-flex align-items-center position-relative overflow-hidden">
        <!-- Fondo animado dinámico -->
        <div class="hero-bg position-absolute top-0 start-0 w-100 h-100"></div>
        <div class="hero-shapes position-absolute w-100 h-100">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>

        <div class="container position-relative z-1">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <div class="glass-card p-5 rounded-4 shadow-lg text-dark">
                        <span class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 rounded-pill fw-semibold border border-primary-subtle">
                            <i class="bi bi-stars me-1"></i> Nueva Versión 2.0
                        </span>
                        
                        <h1 class="display-3 fw-bold mb-4 tracking-tight" style="color: #0f172a;">
                            El Futuro de tus<br/> 
                            <span class="text-primary">Datos Geográficos</span>
                        </h1>
                        
                        <p class="lead mb-5 text-secondary px-md-5" style="font-weight: 400; line-height: 1.6;">
                            Explora, analiza y gestiona la información espacial de tu territorio con nuestro visor de mapas reactivo, impulsado por Blazor y Leaflet. Todo en tiempo real.
                        </p>
                        
                        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                            <a href="/dashboard" class="btn btn-primary btn-lg px-5 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-map"></i> Abrir el Visor
                            </a>
                            <a href="/login" class="btn btn-lg px-5 py-3 rounded-pill fw-semibold bg-white text-dark shadow-sm border">
                                Ir a mi cuenta
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-white border-top py-4 text-center text-secondary small">
        <div class="container">
            &copy; 2026 Arquis Visor SIG. Desarrollado con C# y Blazor.
        </div>
    </footer>
</div>

<style>
    /* Estilos estéticos del Landing Page */
    .landing-page {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    
    .tracking-tight {
        letter-spacing: -0.03em;
    }

    .brand-mark-small {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #0ea5e9, #2563eb);
        color: white;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.2rem;
    }

    /* Fondo dinámico y sutil */
    .hero-bg {
        background: linear-gradient(120deg, #f8fafc 0%, #e0f2fe 100%);
        z-index: 0;
    }

    /* Figuras flotantes (Blobs) */
    .hero-shapes .shape {
        position: absolute;
        filter: blur(80px);
        opacity: 0.5;
        z-index: 0;
        border-radius: 50%;
        animation: float 20s infinite;
    }

    .shape-1 {
        top: -10%; left: -10%;
        width: 500px; height: 500px;
        background: #bae6fd;
    }

    .shape-2 {
        bottom: -20%; right: -10%;
        width: 600px; height: 600px;
        background: #ddd6fe;
        animation-delay: -5s;
    }

    .shape-3 {
        top: 20%; left: 50%;
        width: 400px; height: 400px;
        background: #fbcfe8;
        animation-delay: -10s;
    }

    /* Glassmorphism card */
    .glass-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    /* Animación flotante de las figuras */
    @@keyframes float {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(30px, -50px) scale(1.1); }
        66% { transform: translate(-20px, 20px) scale(0.9); }
    }
</style>
