<Window x:Class="Arquis.Migrador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arquis - Migrador SHP a SQL Server" Height="650" Width="1020" MinHeight="520" MinWidth="820">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Migrador de capas SIG" />
    <DockPanel Grid.Row="1" Margin="0,14,0,14">
      <Button x:Name="SelectFolderButton" Content="Seleccionar carpeta de capas" Padding="14,7" Click="SelectFolder_Click" />
      <TextBlock x:Name="FolderText" Margin="14,0,0,0" VerticalAlignment="Center" Text="Seleccione la carpeta que contiene los archivos SHP." TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Conexión SQL Server:" Margin="0,0,8,0" />
      <TextBox x:Name="ConnectionText" Grid.Column="1" Text="Server=(localdb)\MSSQLLocalDB;Database=VisorDatosSIG;Trusted_Connection=True;TrustServerCertificate=True;" />
      <Button x:Name="TestConnectionButton" Grid.Column="2" Content="Probar conexión" Padding="14,7" Margin="8,0,0,0" Click="TestConnection_Click" />
    </Grid>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DataGrid x:Name="LayersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Capa" Binding="{Binding DisplayName}" Width="150" />
          <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="220" />
          <DataGridTextColumn Header="Geometría" Binding="{Binding GeometryType}" Width="130" />
          <DataGridTextColumn Header="Registros" Binding="{Binding RecordCount}" Width="85" />
          <DataGridTextColumn Header="Extensión" Binding="{Binding Extent}" Width="190" />
          <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBox x:Name="DetailsText" Grid.Row="1" Margin="0,14,0,0" Height="120" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    </Grid>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="ValidateButton" Content="Validar capas" Padding="14,7" Margin="0,0,8,0" IsEnabled="False" Click="Validate_Click" />
      <Button x:Name="ImportButton" Content="Importar a SQL Server" Padding="14,7" IsEnabled="False" ToolTip="Se habilitará al completar la validación y configuración de conexión." Click="Import_Click" />
    </StackPanel>
  </Grid>
</Window>
