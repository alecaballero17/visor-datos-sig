# Plantilla de configuracion de Arquis (sin secretos). Valores para un servidor Linux.
# Cree su .env con el asistente:  ./arquis.sh entorno crear   (Windows: arquis.cmd entorno crear)
# Las lineas comentadas son opcionales: su valor por defecto ya sirve.

# ── Aplicacion ──────────────────────────────────
# Entorno ASP.NET Core  [Production | Development | Staging]
ARQUIS_ENV=Production
# Nivel de log  [Trace | Debug | Information | Warning | Error]
# LOG_LEVEL=Information

# ── Base de datos ───────────────────────────────
# Servidor SQL Server (host[,puerto])
DB_SERVER=127.0.0.1
# Nombre de la base
DB_NAME=VisorDatosSIG
# Autenticacion  [sql | windows]
DB_AUTH=sql
# Usuario SQL (DB_AUTH=sql)
DB_USER=sa
# Contrasena SQL (DB_AUTH=sql)
DB_PASSWORD=
# Cuenta administradora que usa la CLI (crear base, migrar, respaldar); vacio = DB_USER
# DB_ADMIN_USER=
# Contrasena de la cuenta administradora
# DB_ADMIN_PASSWORD=
# Aceptar certificado autofirmado del servidor  [true | false]
# DB_TRUST_CERT=true

# ── Backend ─────────────────────────────────────
# Interfaz de escucha de la API
# BACKEND_HOST=127.0.0.1
# Puerto de la API
BACKEND_PORT=5080
# Entidades por consulta del visor
# VIEWER_DEFAULT_FEATURE_LIMIT=1500
# Maximo de entidades por consulta
# VIEWER_MAX_FEATURE_LIMIT=5000

# ── Frontend ────────────────────────────────────
# Interfaz de escucha del visor
# FRONTEND_HOST=127.0.0.1
# Puerto del visor
FRONTEND_PORT=5180

# ── Servidor ────────────────────────────────────
# Carpeta de instalacion
DEPLOY_DIR=/opt/arquis
# Usuario que ejecuta los servicios (vacio en Windows = LocalSystem)
SERVICE_USER=arquis

# ── Publicacion ─────────────────────────────────
# Publicar detras de nginx  [true | false]
NGINX_ENABLED=true
# Dominio del visor (ej. sig.midominio.com; _ = cualquiera / IP)
WEB_DOMAIN=_
# Subdominio de la API para la app movil (ej. api.midominio.com; vacio = solo WEB_DOMAIN/api)
API_DOMAIN=
# Certificado HTTPS (cloudflare = certificado de origen, si el DNS pasa por Cloudflare)  [none | letsencrypt | cloudflare | manual]
HTTPS=none
# Correo para avisos de Let's Encrypt (HTTPS=letsencrypt)
LETSENCRYPT_EMAIL=
# Certificado (fullchain.pem); lo completa Let's Encrypt
# NGINX_SSL_CERT=
# Clave privada (privkey.pem); la completa Let's Encrypt
# NGINX_SSL_KEY=
# Puerto HTTP publico
# NGINX_PORT=80
# URL publica de la API (vacio = automatica desde los dominios)
# BACKEND_PUBLIC_URL=

# ── Despliegue ──────────────────────────────────
# Versiones anteriores a conservar
# DEPLOY_KEEP_RELEASES=5
# Ejecutar pruebas antes de desplegar  [true | false]
# DEPLOY_RUN_TESTS=true
# Respaldar la base antes de migrar  [true | false]
# DEPLOY_BACKUP_DB=true
# Arrancar los servicios con el sistema  [true | false]
# DEPLOY_AUTOSTART=true
# Abrir puertos en el firewall  [true | false]
# DEPLOY_OPEN_FIREWALL=false
# Prefijo del nombre de los servicios
# SERVICE_PREFIX=Arquis
# Gestor de servicios  [auto | systemd | nssm]
# SERVICE_MANAGER=auto
# Tamano maximo de subida
# NGINX_MAX_BODY=50m
# Version de nginx (solo Windows)
# NGINX_VERSION=1.26.2
# Carpeta con las capas SHP
# SHP_DIR=03_DatosPrueba/DatosSIG_Reproj
