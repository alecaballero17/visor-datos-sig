# API que usa la app movil (se empaqueta dentro de la app: main.dart carga este archivo).
# Produccion: subdominio publico de la API (nginx + Cloudflare).
# Para probar contra un backend local:  flutter run --dart-define=API_URL_ANDROID=http://10.0.2.2:5080/api
# o desde la CLI:                       arquis entorno set MOVIL_API_URL http://<ip>:5080/api
API_URL_LOCAL=localhost:5080/api
API_URL_ANDROID=localhost:5080/api
